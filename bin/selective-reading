    vdir.mkdir(parents=True, exist_ok=True)
    zpath = hf_hub_download(repo, zname)
    with tempfile.TemporaryDirectory() as tmpdir:
        subprocess.run(["bsdtar", "-xf", zpath, "-C", tmpdir], check=True)
        for f in Path(tmpdir).rglob("*"):
