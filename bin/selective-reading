            mod_file.write_text(txt, encoding="utf-8")

    for rel in ("rmvpe.py", "jit/get_rmvpe.py", "jit/__init__.py"):
        fpath = infer_dir / rel
        if fpath.exists():
            ftxt = fpath.read_text(encoding="utf-8")
