def setup_environment(show_notifications: bool = False) -> None:
    MODEL_DIR.mkdir(parents=True, exist_ok=True)
    F5_DIR.mkdir(parents=True, exist_ok=True)
    F5_VOCOS_DIR.mkdir(parents=True, exist_ok=True)
    VOICES_DIR.mkdir(parents=True, exist_ok=True)
    RVC_DIR.mkdir(parents=True, exist_ok=True)

    plugin_voices_dirs = [
        HOME / ".config" / "omarchy" / "plugins" / "raqune.selective-reading" / "voices",
        HOME / "Projects" / "Omarchy-Plugins" / "plugins" / "raqune.selective-reading" / "voices",
    ]
    for pdir in plugin_voices_dirs:
        if pdir.exists():
            for wav_f in pdir.glob("*.wav"):
                dest_f = VOICES_DIR / wav_f.name
                if not dest_f.exists() or dest_f.stat().st_size != wav_f.stat().st_size:
                    shutil.copy2(wav_f, dest_f)

    # 1. Ensure Python 3.12 GPU venv and F5-TTS + RVC dependencies exist
    if not VENV_PYTHON.exists():
        if show_notifications:
            notify("Selective Reading", "Creating Python 3.12 GPU F5-TTS + RVC v2 environment…")
        subprocess.run(["uv", "venv", "--python", "3.12", str(VENV_DIR), "--allow-existing"], check=True)
        subprocess.run(
            [
                "uv",
                "pip",
                "install",
                "--python",
                str(VENV_PYTHON),
                "torch",
                "torchaudio",
                "transformers",
                "huggingface-hub",
                "faiss-cpu",
                "torchcrepe",
                "pyworld",
                "praat-parselmouth",
                "soundfile",
                "librosa",
                "scipy",
                "vocos",
                "x-transformers",
                "torchdiffeq",
                "ema-pytorch",
                "cached-path",
                "pypinyin",
                "rjieba",
                "unidecode",
                "tomli",
                "pydub",
                "accelerate",
                "hydra-core",
                "omegaconf",
                "setuptools<81",
            ],
            check=True,
        )
        subprocess.run(
            ["uv", "pip", "install", "--python", str(VENV_PYTHON), "--no-deps", "inferrvc", "f5-tts"],
            check=True,
        )

    _patch_inferrvc_in_venv()

    # 2. Download F5-TTS v1 Base + Vocos + RVC v2 models if missing
    missing_models = (
        not F5_CKPT_FILE.exists()
        or not (F5_VOCOS_DIR / "pytorch_model.bin").exists()
        or any(not (RVC_DIR / vid / vinfo["pth_name"]).exists() for vid, vinfo in VOICES.items() if vinfo.get("pth_name"))
    )
    if missing_models:
        if show_notifications:
            notify("Selective Reading", "Downloading F5-TTS + RVC v2 celebrity models…")
        dl_code = """
