            cfg_py.write_text(ctxt, encoding="utf-8")

    pipe_py = infer_dir / "pipeline.py"
    if pipe_py.exists():
        ptxt = pipe_py.read_text(encoding="utf-8")
        if 'hf_hub_download("lj1995/VoiceConversionWebUI", "rmvpe.pt")' in ptxt:
            ptxt = ptxt.replace(
                'hf_hub_download("lj1995/VoiceConversionWebUI", "rmvpe.pt")',
                'os.path.expanduser("~/.local/share/omarchy/selective-reading/rvc_models/rmvpe.pt")',
            )
        if 'audio, (self.t_pad, self.t_pad), mode="reflect"' in ptxt:
