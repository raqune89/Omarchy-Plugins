def load_hubert(config):
    cfg_file = hf_hub_download("lj1995/VoiceConversionWebUI", "hubert_base/config.json")
    bin_file = hf_hub_download("lj1995/VoiceConversionWebUI", "hubert_base/pytorch_model.bin")
    hf_hub_download("lj1995/VoiceConversionWebUI", "hubert_base/preprocessor_config.json")
    hubert_dir = str(Path(cfg_file).parent)
    hf_model = HubertModel.from_pretrained(hubert_dir)
    sd = torch.load(bin_file, map_location="cpu", weights_only=False)
    final_proj = torch.nn.Linear(768, 256)
    if "final_proj.weight" in sd and "final_proj.bias" in sd:
        final_proj.weight.data.copy_(sd["final_proj.weight"])
        final_proj.bias.data.copy_(sd["final_proj.bias"])
    hubert_model = _TransformersHubertWrapper(hf_model, final_proj).to(config.device)
    if config.is_half:
        hubert_model = hubert_model.half()
    else:
        hubert_model = hubert_model.float()
    return hubert_model.eval()"""
            txt = txt.replace(old_load, new_load)
            txt = txt.replace(
                "return audio.to(deviceto, non_blocking=True)",
                "return audio.to(deviceto, dtype=torch.float32, non_blocking=True)",
            )
            txt = txt.replace(
                "out = self[fromto](audio.to(_devgp, non_blocking=True)).to(",
                "out = self[fromto](audio.to(_devgp, dtype=torch.float32, non_blocking=True)).to(",
            )
            txt = txt.replace(
                'self.cpt = torch.load(model_path, map_location="cpu")',
                'self.cpt = torch.load(model_path, map_location="cpu", weights_only=False)',
