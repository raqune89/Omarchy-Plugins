TERMINAL_PUNCT = (".", "!", "?", ":", ";")
SOFT_TRAILING_WORDS = {
    "a", "an", "the", "and", "or", "but", "nor", "for", "yet", "so",
    "in", "on", "at", "to", "from", "by", "with", "of", "as", "into",
    "like", "through", "after", "over", "between", "out", "against",
    "during", "without", "before", "under", "around", "among", "that",
    "which", "who", "whom", "whose", "is", "are", "was", "were", "be",
}


class _StructuredHTMLParser(HTMLParser):
    HEADING_TAGS = {"h1", "h2", "h3", "h4", "h5", "h6"}
    BLOCK_TAGS = {
        "p", "div", "section", "article", "blockquote", "pre",
        "header", "footer", "main", "aside", "figcaption", "dt", "dd",
    }
    IGNORE_TAGS = {"script", "style", "noscript", "svg"}

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self._ignore_depth = 0

    def _ensure_punctuated(self) -> None:
        while self.parts and self.parts[-1] in (" ", "\t"):
            self.parts.pop()
        if not self.parts:
            return
        combined = "".join(self.parts).rstrip()
        if not combined:
            return
        last_line = combined.split("\n")[-1].strip()
        if last_line and not last_line.endswith(TERMINAL_PUNCT):
            self.parts.append(".")

    def _append_newline(self, count: int = 1) -> None:
        current = "".join(self.parts)
        trailing_nl = len(current) - len(current.rstrip("\n"))
        needed = max(0, count - trailing_nl)
        if needed > 0 and current.strip():
            self.parts.append("\n" * needed)

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        t = tag.lower()
        if t in self.IGNORE_TAGS:
            self._ignore_depth += 1
            return
        if self._ignore_depth > 0:
            return

        if t in self.HEADING_TAGS or t in self.BLOCK_TAGS or t in ("ul", "ol"):
            self._append_newline(2)
        elif t in ("li", "tr", "br", "hr"):
            self._append_newline(1)

    def handle_endtag(self, tag: str) -> None:
        t = tag.lower()
        if t in self.IGNORE_TAGS:
            self._ignore_depth = max(0, self._ignore_depth - 1)
            return
        if self._ignore_depth > 0:
            return

        if t in self.HEADING_TAGS:
            self._ensure_punctuated()
            self._append_newline(2)
        elif t == "li":
            self._ensure_punctuated()
            self._append_newline(1)
        elif t in ("td", "th"):
            self._ensure_punctuated()
            self.parts.append(" ")
        elif t == "tr":
            self._ensure_punctuated()
            self._append_newline(1)
        elif t in self.BLOCK_TAGS or t in ("ul", "ol"):
            self._append_newline(2)

    def handle_data(self, data: str) -> None:
        if self._ignore_depth > 0:
            return
        cleaned = re.sub(r"\s+", " ", data)
        if cleaned:
            self.parts.append(cleaned)

    def get_text(self) -> str:
        return "".join(self.parts).strip()


def html_to_structured_text(raw_html: str) -> str:
    parser = _StructuredHTMLParser()
    try:
        parser.feed(raw_html)
        parser.close()
        return parser.get_text()
    except Exception:
        return ""


def _ensure_sentence_end(line: str) -> str:
    s = line.strip()
    if not s:
        return ""
    if s.endswith(TERMINAL_PUNCT):
        return s
    if s.endswith(","):
        return s[:-1] + "."
    return s + "."


def _looks_like_heading(line: str, next_line: str | None) -> bool:
    s = line.strip()
    if not s or s.endswith(TERMINAL_PUNCT) or s.endswith(","):
        return False
    if next_line is None or next_line.strip() == "":
        return len(s) <= 120
    words = s.split()
    if 1 <= len(words) <= 8 and len(s) <= 65:
        last_word = re.sub(r"[^a-zA-Z]", "", words[-1]).lower()
        nxt = next_line.strip()
        if last_word not in SOFT_TRAILING_WORDS and nxt and nxt[0].isupper():
            return True
    return False


_ONES = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
         "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
         "seventeen", "eighteen", "nineteen"]
_TENS = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
_ORDINALS_SPECIAL = {
    "one": "first", "two": "second", "three": "third", "five": "fifth",
    "eight": "eighth", "nine": "ninth", "twelve": "twelfth"
}

def _int_to_words(n: int) -> str:
    if n == 0:
        return "zero"
    if n < 0:
        return f"negative {_int_to_words(-n)}"
    if n < 20:
        return _ONES[n]
    if n < 100:
        rem = n % 10
        return f"{_TENS[n // 10]}-{_ONES[rem]}" if rem else _TENS[n // 10]
    if n < 1000:
        rem = n % 100
        if rem:
            return f"{_ONES[n // 100]} hundred {_int_to_words(rem)}".strip()
        return f"{_ONES[n // 100]} hundred"
    for scale, name in [(1_000_000_000, "billion"), (1_000_000, "million"), (1_000, "thousand")]:
        if n >= scale:
            head = n // scale
            rem = n % scale
            res = f"{_int_to_words(head)} {name}"
            if rem:
                res += f" {_int_to_words(rem)}"
            return res.strip()
    return str(n)

def _year_to_words(n: int) -> str:
    if 1000 <= n <= 9999:
        c = n // 100
        rem = n % 100
        if rem == 0:
            return f"{_int_to_words(c)} hundred"
        if rem < 10:
            return f"{_int_to_words(c)} oh {_ONES[rem]}"
        return f"{_int_to_words(c)} {_int_to_words(rem)}"
    return _int_to_words(n)

def _int_to_ordinal(n: int) -> str:
    w = _int_to_words(n)
    words = w.split()
    last = words[-1]
    if "-" in last:
        parts = last.split("-")
        p_last = parts[-1]
        parts[-1] = _ORDINALS_SPECIAL.get(p_last, p_last[:-1] + "ieth" if p_last.endswith("y") else p_last + "th")
        words[-1] = "-".join(parts)
    else:
        words[-1] = _ORDINALS_SPECIAL.get(last, last[:-1] + "ieth" if last.endswith("y") else last + "th")
    return " ".join(words)


def normalize_text_for_speech(raw_text: str) -> str:
    text = raw_text

    # 1. Remove markdown links [anchor](url) -> anchor
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    # 2. Strip code blocks
    text = re.sub(r"```[\s\S]*?```", "", text)

    # 3. Demangle snake_case identifiers (first_sample -> first sample, 100ms_rms -> 100ms rms)
    text = text.replace("_", " ")

    # 4. Compound and SI units attached to numbers (before CamelCase splitting so MeV/GeV stay intact)
    compound_units = [
        (r"(\b\d+(?:\.\d+)?)\s*m/s(?:\^2|²)\b", r"\1 meters per second squared"),
        (r"(\b\d+(?:\.\d+)?)\s*km/s\b", r"\1 kilometers per second"),
        (r"(\b\d+(?:\.\d+)?)\s*m/s\b", r"\1 meters per second"),
        (r"(\b\d+(?:\.\d+)?)\s*km/h\b", r"\1 kilometers per hour"),
    ]
    for pat, rep in compound_units:
        text = re.sub(pat, rep, text)
    # Particle-physics energy-mass units (eV/c2, MeV/c2, GeV/c2, eV/c) and standalone units
    ev_scales = [("TeV", "tera electron volts"), ("GeV", "giga electron volts"), ("MeV", "mega electron volts"), ("keV", "kilo electron volts"), ("eV", "electron volts")]
    for sym, full in ev_scales:
        text = re.sub(rf"(?:(\b\d+(?:\.\d+)?)\s*|\b){sym}/c(?:\^2|²|2)\b", lambda m, f=full: f"{m.group(1) + ' ' if m.group(1) else ''}{f} per c squared", text)
        text = re.sub(rf"(?:(\b\d+(?:\.\d+)?)\s*|\b){sym}/c\b", lambda m, f=full: f"{m.group(1) + ' ' if m.group(1) else ''}{f} per c", text)
        text = re.sub(rf"(?:(\b\d+(?:\.\d+)?)\s*|\b){sym}\b", lambda m, f=full: f"{m.group(1) + ' ' if m.group(1) else ''}{f}", text)

    units = {
        "ms": "milliseconds", "sec": "seconds", "s": "seconds", "mins": "minutes", "min": "minutes",
        "hrs": "hours", "hr": "hours", "khz": "kilohertz", "mhz": "megahertz", "ghz": "gigahertz",
        "hz": "hertz", "kb": "kilobytes", "mb": "megabytes", "gb": "gigabytes", "tb": "terabytes",
        "px": "pixels", "fps": "frames per second", "db": "decibels", "w": "watts", "kw": "kilowatts",
        "v": "volts", "mv": "millivolts", "ns": "nanoseconds", "us": "microseconds", "µs": "microseconds",
        "deg": "degrees", "kg": "kilograms", "km": "kilometers", "cm": "centimeters", "mm": "millimeters",
        "nm": "nanometers", "μm": "micrometers", "µm": "micrometers",
    }
    for u, full in units.items():
        text = re.sub(rf"(\b\d+(?:\.\d+)?)\s*{u}\b", rf"\1 {full}", text, flags=re.IGNORECASE)

    # 5. Split CamelCase identifiers (firstSample -> first Sample)
    text = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", text)

    # 6. Math, code, and comparison operators
    text = re.sub(r"\s*==\s*", " equals ", text)
    text = re.sub(r"\s*!=\s*|≠", " does not equal ", text)
    text = re.sub(r"\s*>=\s*|≥", " is greater than or equal to ", text)
    text = re.sub(r"\s*<=\s*|≤", " is less than or equal to ", text)
    text = re.sub(r"\s*≈\s*", " is approximately ", text)
    text = re.sub(r"\+\/\-|\+\-|±", " plus or minus ", text)
    text = re.sub(r"\s*->\s*|\s*=>\s*", " leads to ", text)

    # Superscripts & powers (e.g. E = mc^2, a² + b² = c², x^3, x^n)
    text = re.sub(r"\^2|²", " squared", text)
    text = re.sub(r"\^3|³", " cubed", text)
    text = re.sub(r"\^(\d+)", r" to the power of \1", text)
    # Digits following variables directly (e.g. 'a2 + b2 = c2' or 'mc2' in plain text Wikipedia extracts)
    text = re.sub(r"(?<=[a-zA-Z])2\b", " squared", text)
    text = re.sub(r"(?<=[a-zA-Z])3\b", " cubed", text)

    text = re.sub(r"\s*=\s*", " equals ", text)

    # Arithmetic operators (+, -, *, /) between identifiers/numbers
    text = re.sub(r"(?<=\w)\s*\+\s*(?=\w)", " plus ", text)
    text = re.sub(r"(?<=\w)\s*[\*×]\s*(?=\w)", " times ", text)
    text = re.sub(r"(?<=\w)\s+-\s+(?=\w)", " minus ", text)
    text = re.sub(r"(?<=\d)\s*-\s*(?=\d)", " minus ", text)
    text = re.sub(r"(?<=\b[a-zA-Z0-9])\s*[\/÷]\s*(?=[a-zA-Z0-9]\b)", " over ", text)

    # Space out multi-letter variable products (e.g. 'mc squared' -> 'm c squared')
    text = re.sub(r"\b([a-zA-Z])([a-zA-Z])\s+squared\b", r"\1 \2 squared", text)
    text = re.sub(r"\b([a-zA-Z])([a-zA-Z])\s+cubed\b", r"\1 \2 cubed", text)

    # 7. Currency expansion
    def repl_dollars(m):
        try:
            val = int(m.group(1).replace(",", "").split(".")[0])
            cents = ""
            if "." in m.group(1):
                c_val = int(m.group(1).split(".")[1][:2])
                if c_val:
                    cents = f" and {_int_to_words(c_val)} cents"
            return f"{_int_to_words(val)} dollars{cents}"
        except Exception:
            return m.group(1).replace(",", "") + " dollars"

    text = re.sub(r"\$([0-9,]+(?:\.[0-9]+)?)", repl_dollars, text)

    # 8. Percentage
    def repl_percent(m):
        try:
            val = int(m.group(1).replace(",", "").split(".")[0])
            return f"{_int_to_words(val)} percent"
        except Exception:
            return f"{m.group(1)} percent"

    text = re.sub(r"([0-9]+(?:\.[0-9]+)?)\s*%", repl_percent, text)

    # 9. Decimals (e.g. 0.00000 -> zero point zero, 3.14 -> three point one four)
    def repl_decimal(m):
        whole_str, frac_str = m.group(1), m.group(2)
        try:
            w_val = int(whole_str)
            w_words = _int_to_words(w_val)
            if set(frac_str) == {"0"}:
                return f"{w_words} point zero"
            frac_words = " ".join("zero" if d == "0" else _ONES[int(d)] for d in frac_str)
            return f"{w_words} point {frac_words}"
        except Exception:
            return m.group(0)

    text = re.sub(r"\b(\d+)\.(\d+)\b", repl_decimal, text)

    # 10. Ordinals (1st, 2nd, 3rd, 4th...)
    def repl_ordinal(m):
        try:
            return _int_to_ordinal(int(m.group(1)))
        except Exception:
            return m.group(0)

    text = re.sub(r"\b([0-9]+)(?:st|nd|rd|th)\b", repl_ordinal, text, flags=re.IGNORECASE)

    # 11. Common abbreviations
    abbrevs = {
        r"\be\.g\.,?": "for example,",
        r"\bi\.e\.,?": "that is,",
        r"\betc\b\.?": "etcetera",
        r"\bvs\b\.?": "versus",
        r"\bDr\b\.": "Doctor",
        r"\bMr\b\.": "Mister",
        r"\bMrs\b\.": "Missus",
        r"\bMs\b\.": "Miz",
        r"\bProf\b\.": "Professor",
        r"\bapprox\b\.": "approximately",
        r"\bconfig\b": "configuration",
        r"\bparams?\b": "parameters",
        r"\bargs?\b": "arguments",
        r"\bfuncs?\b": "function",
        r"\bdest\b": "destination",
        r"\bsrc\b": "source",
    }
    for pat, rep in abbrevs.items():
        text = re.sub(pat, rep, text, flags=re.IGNORECASE)

    # Strip trailing periods from single capitalized initials (e.g. "Dwight D. Eisenhower" -> "Dwight D Eisenhower")
    text = re.sub(r"\bU\.S\.", "you ess", text)
    text = re.sub(r"\bU\.K\.", "you kay", text)
    text = re.sub(r"\b([A-Z])\.\s+(?=[A-Z])", r"\1 ", text)

    # 12. Common Acronyms and Technical Initialisms (phonetic words for F5-TTS duration & vowel continuity)
    _LETTER_PHONETICS = {
        "A": "ay", "B": "bee", "C": "see", "D": "dee", "E": "ee", "F": "eff",
        "G": "jee", "H": "aitch", "I": "eye", "J": "jay", "K": "kay", "L": "el",
        "M": "em", "N": "en", "O": "oh", "P": "pee", "Q": "cue", "R": "are",
        "S": "ess", "T": "tee", "U": "you", "V": "vee", "W": "double you",
        "X": "ex", "Y": "why", "Z": "zee",
    }
    acronyms_ci = {
        "rms": "are em ess", "asr": "ay ess are", "tts": "tee tee ess", "dac": "dee ay see",
        "pcm": "pee see em", "ipc": "eye pee see", "api": "ay pee eye", "sdk": "ess dee kay",
        "url": "you are el", "uri": "you are eye", "gpu": "jee pee you", "cpu": "see pee you",
        "vram": "vee ram", "cli": "see el eye", "gui": "jee you eye", "pid": "pee eye dee",
        "pdf": "pee dee eff", "html": "aitch tee em el", "css": "see ess ess", "sql": "sequel",
        "ssh": "ess ess aitch", "ssl": "ess ess el", "tls": "tee el ess", "tcp": "tee see pee",
        "udp": "you dee pee", "dns": "dee en ess", "http": "aitch tee tee pee",
        "https": "aitch tee tee pee ess", "json": "jason", "xml": "ex em el",
        "csv": "see ess vee", "yaml": "yam el", "llm": "el el em", "rvc": "are vee see",
        "nfe": "en eff ee", "uuid": "you you eye dee", "fft": "eff eff tee",
        "snr": "ess en are", "bpm": "bee pee em", "wpm": "words per minute",
        "usb": "you ess bee", "ssd": "ess ess dee", "hdd": "aitch dee dee",
        "rgb": "are jee bee", "fps": "eff pee ess", "faq": "eff ay cue",
        "phd": "pee aitch dee", "ceo": "see ee oh", "cto": "see tee oh",
        "cfo": "see eff oh", "usa": "you ess ay", "fbi": "eff bee eye",
        "cia": "see eye ay", "nsa": "en ess ay", "nvme": "en vee em ee",
        "gps": "jee pee ess", "ieee": "eye triple ee",
    }
    for acr, rep in acronyms_ci.items():
        text = re.sub(rf"\b{acr}(s)?\b", lambda m, r=rep: f"{r}{'s' if m.group(1) else ''}", text, flags=re.IGNORECASE)

    # Short 2-3 letter acronyms that collide with lowercase words: match uppercase only
    acronyms_cs = {
        "AI": "ay eye", "ML": "em el", "OS": "oh ess", "IO": "eye oh",
        "IP": "eye pee", "UI": "you eye", "UX": "you ex", "UK": "you kay",
        "EU": "ee you", "US": "you ess", "ID": "eye dee", "PC": "pee see",
        "TV": "tee vee", "CD": "see dee", "DVD": "dee vee dee", "IT": "eye tee",
        "SI": "ess eye", "IOC": "eye oh see", "ESA": "ee ess ay",
        "AC": "ay see", "DC": "dee see", "UV": "you vee", "IR": "eye are",
        "RF": "are eff", "LED": "el ee dee", "MRI": "em are eye", "RAM": "ram",
    }
    for acr, rep in acronyms_cs.items():
        text = re.sub(rf"\b{acr}(s)?\b", lambda m, r=rep: f"{r}{'s' if m.group(1) else ''}", text)

    # General fallback: any remaining 2-6 char all-caps token with NO vowels (e.g. CGPM, GNSS, ICBM)
    def repl_unvowel_acronym(m):
        tok, pl = m.group(1), m.group(2) or ""
        spelled = " ".join(_LETTER_PHONETICS[c] for c in tok)
        return f"{spelled}{'s' if pl else ''}"

    text = re.sub(r"\b([BCDFGHJKLMNPQRSTVWXZ]{2,6})(s)?\b", repl_unvowel_acronym, text)

    # 13. Convert numbers to words (e.g. 1993, 4500)
    def repl_num(m):
        num_str = m.group(0).replace(",", "")
        try:
            val = int(num_str)
            if 1900 <= val <= 2099:
                return _year_to_words(val)
            return _int_to_words(val)
        except Exception:
            return m.group(0)

    text = re.sub(r"\b\d{1,3}(?:,\d{3})+\b|\b\d+\b", repl_num, text)

    # 14. Symbols
    text = text.replace("&", " and ").replace("@", " at ").replace("/", " or ")

    # 15. Normalize dashes, ellipses, parentheses, brackets
    text = re.sub(r"(?<=\w)–(?=\w)", "-", text)
    text = re.sub(r"[—–]", ", ", text)
    text = re.sub(r"\.{3,}|…", ", and so on. ", text)
    text = re.sub(r"\s*\(\s*([^)]{1,45})\s*\)\s*", r", \1, ", text)
    text = re.sub(r"[\(\)\[\]\{\}<>]+", " ", text)
    text = re.sub(r"[*_~`]+", "", text)
    text = re.sub(r"[\"“”'‘’]", "", text)
    text = re.sub(r",\s*,+", ",", text)
    text = re.sub(r",\s*([.!?;:])", r"\1", text)

    # 16. Normalize spacing
    text = re.sub(r"[ \t]+", " ", text).strip()
    return text


def format_text_for_speech(raw: str) -> str:
    text = raw.replace("\r\n", "\n").replace("\r", "\n")

    raw_lines = text.split("\n")
    normalized_lines: list[tuple[str, str]] = []

    for line in raw_lines:
        stripped = re.sub(r"[ \t]+", " ", line).strip()
        if not stripped:
            normalized_lines.append(("blank", ""))
            continue

        m_head = re.match(r"^#{1,6}\s+(.*)$", stripped)
        if m_head:
            normalized_lines.append(("heading", _ensure_sentence_end(normalize_text_for_speech(m_head.group(1)))))
            continue

        m_bullet = re.match(r"^[•●◦▪▸▹–—*-]\s*(.+)$", stripped)
        if m_bullet:
            normalized_lines.append(("item", _ensure_sentence_end(normalize_text_for_speech(m_bullet.group(1)))))
            continue

        m_num = re.match(r"^(\d+)[.)]\s+(.+)$", stripped)
        if m_num:
            normalized_lines.append(("item", f"{m_num.group(1)}. {_ensure_sentence_end(normalize_text_for_speech(m_num.group(2)))}"))
            continue

        normalized_lines.append(("text", normalize_text_for_speech(stripped)))

    out_blocks: list[str] = []
    current_para: list[str] = []

    def flush_para() -> None:
        if not current_para:
            return
        joined = " ".join(current_para).strip()
        if joined:
            out_blocks.append(_ensure_sentence_end(joined))
        current_para.clear()

    n = len(normalized_lines)
    for i, (kind, content) in enumerate(normalized_lines):
        next_kind, next_content = normalized_lines[i + 1] if i + 1 < n else ("blank", "")
        prev_kind = normalized_lines[i - 1][0] if i > 0 else "blank"

        if kind == "blank":
            flush_para()
            continue

        if kind == "heading":
            flush_para()
            out_blocks.append(content)
            continue

        if kind == "item":
            flush_para()
            out_blocks.append(content)
            continue

        words = content.split()
        is_short_token = len(words) <= 4 and len(content) <= 40 and not content.endswith(TERMINAL_PUNCT)
        if is_short_token and (prev_kind in ("blank", "item") or next_kind in ("blank", "item")):
            flush_para()
            out_blocks.append(_ensure_sentence_end(content))
            continue

        if not current_para and _looks_like_heading(content, None if next_kind == "blank" else next_content):
            out_blocks.append(_ensure_sentence_end(content))
            continue

        current_para.append(content)

    flush_para()

    formatted = "\n\n".join(out_blocks).strip()
    return formatted[:15000]


def load_config() -> dict:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if CONFIG_FILE.exists():
        try:
            data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            voice = data.get("voice", DEFAULT_CONFIG["voice"])
            changed = False
            if voice not in VOICES:
                if str(voice).startswith("shayne_topp"):
                    voice = "shayne_topp"
                else:
                    voice = DEFAULT_CONFIG["voice"]
                changed = True
            rate = data.get("rate", DEFAULT_CONFIG["rate"])
            if not re.match(r"^[+-]\d+%$", str(rate)):
                rate = DEFAULT_CONFIG["rate"]
                changed = True
            vol = data.get("volume", DEFAULT_CONFIG["volume"])
            try:
                vol = max(0, min(100, int(vol)))
            except Exception:
                vol = DEFAULT_CONFIG["volume"]
                changed = True
            if data.get("volume") != vol:
                changed = True
            cfg = {"voice": voice, "rate": rate, "volume": vol}
            if changed:
                save_config(cfg)
            return cfg
        except Exception:
            pass
    save_config(DEFAULT_CONFIG)
    return dict(DEFAULT_CONFIG)


def save_config(cfg: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONFIG_FILE)


def load_state() -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if STATE_FILE.exists():
        try:
            st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            if st.get("voice") in VOICES:
                return st
        except Exception:
            pass
    cfg = load_config()
    voice_id = cfg["voice"]
    return {
        "isPlaying": False,
        "isPaused": False,
        "voice": voice_id,
        "voiceName": VOICES.get(voice_id, {}).get("name", "Morgan Freeman"),
        "rate": cfg["rate"],
        "volume": cfg.get("volume", 100),
        "textSnippet": "",
        "updatedAt": int(time.time()),
    }


def write_state(
    is_playing: bool,
    snippet: str | None = None,
    is_paused: bool | None = None,
) -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prev = load_state()
    cfg = load_config()
    voice_id = cfg["voice"]
    paused_val = (
        False
        if not is_playing
        else (is_paused if is_paused is not None else bool(prev.get("isPaused", False)))
    )
    state = {
        "isPlaying": is_playing,
        "isPaused": paused_val,
        "voice": voice_id,
        "voiceName": VOICES.get(voice_id, {}).get("name", "Morgan Freeman"),
        "rate": cfg["rate"],
        "volume": cfg.get("volume", 100),
        "textSnippet": snippet if snippet is not None else prev.get("textSnippet", ""),
        "updatedAt": int(time.time()),
    }
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    tmp.replace(STATE_FILE)
    return state


def notify(title: str, body: str) -> None:
    try:
        subprocess.run(
            [
                "notify-send",
                "-a",
                "Selective Reading",
                "-t",
                "2500",
                "-h",
                "string:x-canonical-private-synchronous:selective-reading",
                title,
                body,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except Exception:
        pass


def get_running_pid(pid_file: Path = PID_FILE) -> int | None:
    if not pid_file.exists():
        return None
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        try:
            pid_file.unlink(missing_ok=True)
        except Exception:
            pass
        return None


def _mpv_ipc_command(cmd_list: list) -> dict | None:
    for _ in range(20):
        if MPV_IPC_SOCKET.exists():
            break
        time.sleep(0.025)
    if not MPV_IPC_SOCKET.exists():
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1.0)
            sock.connect(str(MPV_IPC_SOCKET))
            payload = (json.dumps({"command": cmd_list}) + "\n").encode("utf-8")
            sock.sendall(payload)
            resp = b""
            while b"\n" not in resp:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                resp += chunk
            for line in resp.decode("utf-8", errors="ignore").splitlines():
                line = line.strip()
                if not line:
                    continue
                data = json.loads(line)
                if "error" in data:
                    return data
    except Exception:
        return None
    return None


def toggle_pause(force_resume: bool = False) -> bool:
    pid = get_running_pid()
    if pid is None:
        write_state(False, is_paused=False)
        notify("Selective Reading", "No active reading to pause.")
        return False

    st = load_state()
    currently_paused = bool(st.get("isPaused", False))
    if force_resume and not currently_paused:
        notify("Selective Reading", "Already playing")
        return True

    target_paused = False if force_resume else (not currently_paused)

    resp = _mpv_ipc_command(["set_property", "pause", target_paused])
    if resp is None or resp.get("error") != "success":
        sig = signal.SIGSTOP if target_paused else signal.SIGCONT
        try:
            os.killpg(os.getpgid(pid), sig)
        except Exception:
            try:
                os.kill(pid, sig)
            except Exception:
                pass

    write_state(True, is_paused=target_paused)
    if target_paused:
        notify("Selective Reading", "Paused reading (SUPER + R to resume)")
    else:
        notify("Selective Reading", "Resumed reading")
    return True


def stop_playback(quiet: bool = False) -> bool:
    pid = get_running_pid()
    was_running = False
    if pid is not None:
        was_running = True
        try:
            pgid = os.getpgid(pid)
            os.killpg(pgid, signal.SIGCONT)
            os.killpg(pgid, signal.SIGTERM)
        except Exception:
            try:
                os.kill(pid, signal.SIGCONT)
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
        for _ in range(10):
            try:
                os.kill(pid, 0)
                time.sleep(0.03)
            except ProcessLookupError:
                break
            except Exception:
                break
        try:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
        except Exception:
            pass
    try:
        PID_FILE.unlink(missing_ok=True)
    except Exception:
        pass
    try:
        MPV_IPC_SOCKET.unlink(missing_ok=True)
    except Exception:
        pass
    write_state(False, is_paused=False)
    if was_running and not quiet:
        notify("Selective Reading", "Stopped reading")
    return was_running


def _fingerprint(s: str) -> str:
    return re.sub(r"\W+", "", s).lower()[:160]


def get_selected_text() -> str:
    for extra_args in (["--primary"], []):
        plain = ""
        try:
            res = subprocess.run(
                ["wl-paste", *extra_args, "--no-newline"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                plain = res.stdout.strip()
        except Exception:
            pass

        if not plain:
            continue

        try:
            types_res = subprocess.run(
                ["wl-paste", *extra_args, "--list-types"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=1,
                check=False,
            )
            if types_res.returncode == 0 and "text/html" in types_res.stdout.splitlines():
                html_res = subprocess.run(
                    ["wl-paste", *extra_args, "--type", "text/html", "--no-newline"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=2,
                    check=False,
                )
                if html_res.returncode == 0 and html_res.stdout.strip():
                    structured = html_to_structured_text(html_res.stdout)
                    if structured and _fingerprint(structured) == _fingerprint(plain):
                        return structured
        except Exception:
            pass

        return plain
    return ""


def rate_to_speed(rate: str = "+0%") -> float:
    # All voices play exclusively at authentic natural speaker speed
    return 1.0


def _daemon_is_ready() -> bool:
    if not DAEMON_SOCKET.exists():
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(str(DAEMON_SOCKET))
            s.sendall((json.dumps({"cmd": "ping"}) + "\n").encode("utf-8"))
            resp = s.recv(64)
            return b"pong" in resp
    except Exception:
        return False


def ensure_daemon_running(show_notifications: bool = True) -> bool:
    if _daemon_is_ready():
        return True

    if (
        not VENV_PYTHON.exists()
        or not F5_CKPT_FILE.exists()
    ):
        if show_notifications:
            notify("Selective Reading", "Setting up F5-TTS voice engine…")
        setup_environment(show_notifications=show_notifications)

    if get_running_pid(DAEMON_PID_FILE) is None:
        if show_notifications:
            notify("Selective Reading", "Warming up GPU F5-TTS voice engine…")
        proc = subprocess.Popen(
            [str(VENV_PYTHON), str(Path(__file__).resolve()), "_daemon"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        DAEMON_PID_FILE.write_text(str(proc.pid), encoding="utf-8")

    for _ in range(160):
        if _daemon_is_ready():
            return True
        time.sleep(0.25)
    return False


def classify_text_energy(text: str) -> str:
    if "!" in text:
        return "high"
    raw_words = [w.strip(".,;:?!\"'()[]{}") for w in text.split()]
    # Only trigger high energy for genuine all-caps shouting (e.g. 3+ consecutive uppercase words or majority all-caps),
    # never for standalone acronyms like NASA, CERN, or DNA.
    alpha_words = [w for w in raw_words if len(w) >= 2 and w.isalpha()]
    upper_count = sum(1 for w in alpha_words if w.isupper())
    consec_upper = 0
    max_consec = 0
    for w in raw_words:
        if len(w) >= 2 and w.isalpha() and w.isupper():
            consec_upper += 1
            max_consec = max(max_consec, consec_upper)
        else:
            consec_upper = 0
    if max_consec >= 3 or (len(alpha_words) >= 3 and upper_count / len(alpha_words) >= 0.6):
        return "high"
    high_energy_keywords = {
        "omg", "wow", "crazy", "insane", "hilarious", "ridiculous",
        "yelled", "screamed", "screaming", "shouted", "dude", "bro",
        "holy", "wild", "unbelievable", "hype", "shut up", "no way"
    }
    lower_words = {w.lower() for w in raw_words}
    if lower_words & high_energy_keywords:
        return "high"
    return "low"


def _chunk_block_for_f5(block: str, max_chars: int = 125) -> list[str]:
    # Split by true sentence terminators (. ! ?)
    raw_sentences = [s.strip() for s in re.split(r"(?<=[.!?])\s+", block) if s.strip()]
    if not raw_sentences:
        return [block] if block.strip() else []

    num_tokens = {
        "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
        "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
        "seventeen", "eighteen", "nineteen", "twenty", "thirty", "forty", "fifty",
        "sixty", "seventy", "eighty", "ninety", "hundred", "thousand", "million",
        "billion", "trillion", "point", "plus", "minus", "or", "per", "meters",
        "kilometers", "seconds", "second", "kilograms", "electron", "volts", "squared", "cubed",
    }
    break_words = {"where", "which", "that", "while", "when", "and", "but", "for", "with", "from", "by", "using", "at", "in"}

    def _is_num_tok(w: str) -> bool:
        clean = w.lower().strip(".,;:!?")
        if clean in num_tokens:
            return True
        if "-" in clean and all(part in num_tokens for part in clean.split("-")):
            return True
        return False

    def _split_long_clause(clause: str) -> list[str]:
        if len(clause) <= max_chars:
            return [clause]
        words = clause.split()
        out: list[str] = []
        idx = 0
        while idx < len(words):
            cur_len = 0
            best_break = None
            safe_break = None
            last_fit = idx + 1
            for j in range(idx, len(words)):
                add = len(words[j]) + (1 if j > idx else 0)
                if cur_len + add > max_chars and j > idx:
                    break
                cur_len += add
                last_fit = j + 1
                if j > idx:
                    # Never split inside contiguous number/unit phrases (e.g. "four hundred fifty-eight")
                    if _is_num_tok(words[j - 1]) and _is_num_tok(words[j]):
                        continue
                    if cur_len >= 25:
                        safe_break = j
                    w_low = words[j].lower().strip(".,;:!?")
                    if w_low in break_words and cur_len >= 25:
                        best_break = j
                    elif best_break is None and cur_len >= int(max_chars * 0.55):
                        best_break = j
            if last_fit == len(words):
                out.append(" ".join(words[idx:]))
                break
            # Prefer semantic break, otherwise safest non-numeric break before falling back to last_fit
            if best_break is not None and best_break > idx:
                split_at = best_break
            elif safe_break is not None and safe_break > idx:
                split_at = safe_break
            else:
                split_at = last_fit
            out.append(" ".join(words[idx:split_at]))
            idx = split_at
        return out

    chunks: list[str] = []
    for s in raw_sentences:
        # Keep complete sentences up to max_chars intact so total ref+gen stays well inside F5-TTS's 22s window
        if len(s) <= max_chars:
            chunks.append(s)
            continue

        # For compound sentences > max_chars, split ONLY at true punctuation boundaries (, ; : —)
        sub_clauses = [c.strip() for c in re.split(r"(?<=[,;:—])\s+", s) if c and c.strip()]
        if len(sub_clauses) <= 1:
            chunks.extend(_split_long_clause(s))
            continue

        # Merge tiny clauses (<= 28 chars, e.g. "In 1983," or parenthetical acronyms) into neighbors
        merged_subs: list[str] = []
        for cl in sub_clauses:
            if merged_subs and len(merged_subs[-1]) <= 28:
                merged_subs[-1] = f"{merged_subs[-1]} {cl}".strip()
            elif merged_subs and len(cl) <= 28 and len(merged_subs[-1]) + 1 + len(cl) <= max_chars:
                merged_subs[-1] = f"{merged_subs[-1]} {cl}".strip()
            else:
                merged_subs.append(cl)
        if len(merged_subs) >= 2 and len(merged_subs[-1]) <= 28:
            merged_subs[-2] = f"{merged_subs[-2]} {merged_subs[-1]}".strip()
            merged_subs.pop()

        # Merge sub-clauses up to max_chars so we keep natural clause continuity
        cur_chunk = ""
        for clause in merged_subs:
            candidate = f"{cur_chunk} {clause}".strip() if cur_chunk else clause
            if len(candidate) <= max_chars:
                cur_chunk = candidate
            else:
                if cur_chunk:
                    chunks.extend(_split_long_clause(cur_chunk))
                cur_chunk = clause
        if cur_chunk:
            chunks.extend(_split_long_clause(cur_chunk))

    return chunks


def run_daemon() -> None:
    import fcntl
    sys.argv = [sys.argv[0]]
    os.environ["HF_HUB_OFFLINE"] = "1"
    lock_file = Path("/tmp/selective-reading-daemon.lock")
    lock_fh = lock_file.open("w", encoding="utf-8")
    try:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    my_pid = os.getpid()
    DAEMON_PID_FILE.write_text(str(my_pid), encoding="utf-8")

    import numpy as np
    import torch
    import torchaudio
    from f5_tts.api import F5TTS
    from f5_tts.infer.utils_infer import infer_batch_process
    from inferrvc import RVC

    try:
        DAEMON_SOCKET.unlink(missing_ok=True)
    except Exception:
        pass

    f5 = F5TTS(
        model="F5TTS_v1_Base",
        ckpt_file=str(F5_CKPT_FILE),
        vocoder_local_path=str(F5_VOCOS_DIR),
        device="cuda",
    )
    rvc_models: dict[str, RVC | None] = {}
    ref_audios: dict[str, tuple[torch.Tensor, int]] = {}

    def _safe_load_ref(wav_path: Path) -> tuple[torch.Tensor, int]:
        audio_t, sr = torchaudio.load(str(wav_path))
        mono = audio_t.mean(dim=0)
        nz = torch.where(torch.abs(mono) > 0.005)[0]
        if len(nz) > 0:
            last_active = int(nz[-1].item()) + 1
            audio_t = audio_t[:, :last_active]
        pad_frames = int(sr * 0.18)
        audio_t = torch.cat([audio_t, torch.zeros((audio_t.shape[0], pad_frames), dtype=audio_t.dtype)], dim=-1)
        return (audio_t, sr)

    for vid, vinfo in VOICES.items():
        if vinfo.get("pth_name"):
            vdir = RVC_DIR / vid
            pth_path = vdir / vinfo["pth_name"]
            idx_path = vdir / vinfo["index_name"]
            rvc_models[vid] = RVC(model=str(pth_path), index=str(idx_path))
        else:
            rvc_models[vid] = None
        ref_audios[vid] = _safe_load_ref(VOICES_DIR / vinfo["ref_wav"])
        if vinfo.get("ref_wav_calm") and (VOICES_DIR / vinfo["ref_wav_calm"]).exists():
            ref_audios[f"{vid}_calm"] = _safe_load_ref(VOICES_DIR / vinfo["ref_wav_calm"])
        if vinfo.get("ref_wav_hype") and (VOICES_DIR / vinfo["ref_wav_hype"]).exists():
            ref_audios[f"{vid}_hype"] = _safe_load_ref(VOICES_DIR / vinfo["ref_wav_hype"])
        if vinfo.get("ref_wav_alt") and (VOICES_DIR / vinfo["ref_wav_alt"]).exists():
            ref_audios[f"{vid}_alt"] = _safe_load_ref(VOICES_DIR / vinfo["ref_wav_alt"])

    # Warm up F5-TTS + RMVPE + Hubert + RVC on CUDA so first user keypress starts quickly
    try:
        first_vid = next(iter(VOICES))
        first_vinfo = VOICES[first_vid]
        for wav_chunk, out_sr in infer_batch_process(
            ref_audios[first_vid],
            first_vinfo["ref_text"],
            ["Ready to read."],
            f5.ema_model,
            f5.vocoder,
            mel_spec_type="vocos",
            progress=None,
            nfe_step=16,
            speed=1.0,
            device="cuda",
            streaming=True,
            chunk_size=240000,
        ):
            wav_t = torch.from_numpy(np.asarray(wav_chunk, dtype=np.float32))
            wav_t.frequency = out_sr
            if rvc_models[first_vid] is not None:
                _ = rvc_models[first_vid](
                    wav_t,
                    f0_up_key=first_vinfo.get("f0_up_key", 0),
                    f0_method="rmvpe",
                    index_rate=first_vinfo.get("index_rate", 0.3),
                    protect=first_vinfo.get("protect", 0.4),
                    output_device="cpu",
                    output_volume=RVC.MATCH_ORIGINAL,
                )
    except Exception:
        pass

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(DAEMON_SOCKET))
    server.listen(4)

    def cleanup_and_exit(signum, frame):
        try:
            server.close()
        except Exception:
            pass
        try:
            if DAEMON_PID_FILE.exists() and DAEMON_PID_FILE.read_text(encoding="utf-8").strip() == str(my_pid):
                DAEMON_SOCKET.unlink(missing_ok=True)
                DAEMON_PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, cleanup_and_exit)
    signal.signal(signal.SIGINT, cleanup_and_exit)

    def synthesize_and_send(conn: socket.socket, text: str, voice: str) -> None:
        vinfo = VOICES.get(voice)
        if not vinfo:
            if str(voice).startswith("shayne_topp"):
                voice = "shayne_topp"
            else:
                voice = DEFAULT_CONFIG["voice"]
            vinfo = VOICES[voice]
        rvc = rvc_models[voice]
        ref_audio = ref_audios[voice]
        ref_text = vinfo["ref_text"]
        text = format_text_for_speech(text)
        if not text:
            return
        blocks = [b.strip() for b in text.split("\n\n") if b.strip()]
        silence_pcm = np.zeros(int(44100 * 0.40), dtype="<f4").tobytes()
        breath_silence_pcm = np.zeros(int(44100 * 0.18), dtype="<f4").tobytes()
        # Pre-roll silence buffer so mpv/pipewire DAC buffer stabilizes without clipping onset
        lead_silence_pcm = np.zeros(int(44100 * 0.08), dtype="<f4").tobytes()
        conn.sendall(lead_silence_pcm)

        nfe_step = vinfo.get("nfe_step", 32)
        base_speed = vinfo.get("base_speed", 1.0)
        is_first_chunk = True
        ref_dur = ref_audio[0].shape[-1] / float(ref_audio[1])
        ref_cps = len(ref_text.encode("utf-8")) / max(1.0, ref_dur)
        safe_max_chars = max(80, min(125, int(ref_cps * max(4.5, 19.5 - ref_dur) * base_speed)))

        for idx, block in enumerate(blocks):
            batches = _chunk_block_for_f5(block, max_chars=safe_max_chars)
            if not batches:
                continue
            for b_idx, batch in enumerate(batches):
                cur_ref = ref_audio
                cur_ref_text = ref_text
                cur_speed = base_speed

                if vinfo.get("adaptive"):
                    energy = classify_text_energy(batch)
                    if energy == "high" and f"{voice}_hype" in ref_audios:
                        cur_ref = ref_audios[f"{voice}_hype"]
                        cur_ref_text = vinfo.get("ref_text_hype", ref_text)
                        cur_speed = vinfo.get("base_speed_hype", base_speed)
                    elif f"{voice}_calm" in ref_audios:
                        cur_ref = ref_audios[f"{voice}_calm"]
                        cur_ref_text = vinfo.get("ref_text_calm", ref_text)
                        cur_speed = vinfo.get("base_speed_calm", base_speed)

                for wav_chunk, out_sr in infer_batch_process(
                    cur_ref,
                    cur_ref_text,
                    [batch],
                    f5.ema_model,
                    f5.vocoder,
                    mel_spec_type="vocos",
                    progress=None,
                    nfe_step=nfe_step,
                    speed=cur_speed,
                    device="cuda",
                    streaming=True,
                    chunk_size=240000,
                ):
                    if rvc is not None:
                        wav_t = torch.from_numpy(np.asarray(wav_chunk, dtype=np.float32))
                        wav_t.frequency = out_sr
                        converted = rvc(
                            wav_t,
                            f0_up_key=vinfo.get("f0_up_key", 0),
                            f0_method="rmvpe",
                            index_rate=vinfo.get("index_rate", 0.3),
                            protect=vinfo.get("protect", 0.4),
                            output_device="cpu",
                            output_volume=RVC.MATCH_ORIGINAL,
                        )
                        conv_np = converted.detach().cpu().numpy().astype(np.float32)
                    else:
                        # Pure F5-TTS zero-shot voice cloning
                        # Resample out_sr (24kHz) to 44.1kHz for MPV raw audio demuxer
                        wav_t = torch.from_numpy(np.asarray(wav_chunk, dtype=np.float32)).unsqueeze(0)
                        resampled = torchaudio.functional.resample(wav_t, out_sr, 44100).squeeze(0)
                        conv_np = resampled.cpu().numpy().astype(np.float32)

                    # Smooth onset micro-fade to eliminate abrupt starts or inter-chunk clicking
                    if conv_np.size > 0:
                        if is_first_chunk:
                            fade_len = min(len(conv_np), int(44100 * 0.025))
                            fade_curve = 0.5 * (1 - np.cos(np.pi * np.linspace(0, 1, fade_len, dtype=np.float32)))
                            conv_np[:fade_len] *= fade_curve
                            is_first_chunk = False
                        else:
                            in_len = min(len(conv_np) // 4, int(44100 * 0.005))
                            if in_len > 0:
                                conv_np[:in_len] *= np.linspace(0.0, 1.0, in_len, dtype=np.float32)
                        out_len = min(len(conv_np) // 4, int(44100 * 0.005))
                        if out_len > 0:
                            conv_np[-out_len:] *= np.linspace(1.0, 0.0, out_len, dtype=np.float32)

                    pk = float(np.max(np.abs(conv_np))) if conv_np.size > 0 else 0.0
                    if pk > 0.90:
                        conv_np = (conv_np / pk) * 0.90
                    pcm = conv_np.astype("<f4").tobytes()
                    conn.sendall(pcm)

                # Natural breath pause between complete sentences within the paragraph
                if b_idx < len(batches) - 1 and batch.rstrip().endswith((".", "!", "?")):
                    conn.sendall(breath_silence_pcm)
            if idx < len(blocks) - 1:
                conn.sendall(silence_pcm)

    while True:
        conn, _ = server.accept()
        with conn:
            try:
                buf = b""
                while b"\n" not in buf:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    buf += chunk
                if not buf:
                    continue
                req = json.loads(buf.decode("utf-8").splitlines()[0])
                cmd = req.get("cmd")
                if cmd == "ping":
                    conn.sendall(b"pong\n")
                    continue
                if cmd != "stream":
                    continue

                text = str(req.get("text", "")).strip()
                voice = str(req.get("voice", DEFAULT_CONFIG["voice"]))
                if voice not in VOICES:
                    voice = DEFAULT_CONFIG["voice"]

                synthesize_and_send(conn, text, voice)
            except (BrokenPipeError, ConnectionResetError):
                continue
            except Exception:
                continue


def stream_tts_to_mpv(text: str, voice: str, rate: str, volume: int = 100) -> None:
    try:
        MPV_IPC_SOCKET.unlink(missing_ok=True)
    except Exception:
        pass

    if not ensure_daemon_running(show_notifications=True):
        raise RuntimeError("GPU RVC v2 daemon failed to start")

    mpv_proc = subprocess.Popen(
        [
            "mpv",
            "--no-video",
            "--really-quiet",
            "--no-terminal",
            "--title=Selective Reading",
            "--demuxer=rawaudio",
            "--demuxer-rawaudio-rate=44100",
            "--demuxer-rawaudio-channels=1",
            "--demuxer-rawaudio-format=floatle",
            "--speed=1.0",
            f"--volume={volume}",
            "--cache=yes",
            "--demuxer-max-bytes=100MiB",
            f"--input-ipc-server={MPV_IPC_SOCKET}",
            "-",
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(str(DAEMON_SOCKET))
            req = {"cmd": "stream", "text": text, "voice": voice}
            sock.sendall((json.dumps(req) + "\n").encode("utf-8"))
            while mpv_proc.poll() is None:
                data = sock.recv(32768)
                if not data:
                    break
                if mpv_proc.stdin:
                    try:
                        mpv_proc.stdin.write(data)
                        mpv_proc.stdin.flush()
                    except (BrokenPipeError, OSError):
                        break
        if mpv_proc.stdin:
            try:
                mpv_proc.stdin.close()
            except Exception:
                pass
        mpv_proc.wait()
    finally:
        if mpv_proc.poll() is None:
            mpv_proc.terminate()
            try:
                mpv_proc.wait(timeout=1)
            except Exception:
                mpv_proc.kill()
        try:
            MPV_IPC_SOCKET.unlink(missing_ok=True)
        except Exception:
            pass


def run_worker(text: str, voice: str, rate: str, volume: int = 100) -> None:
    my_pid = os.getpid()
    PID_FILE.write_text(str(my_pid), encoding="utf-8")

    def handle_sig(signum, frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)

    one_line = re.sub(r"\s+", " ", text).strip()
    snippet = one_line[:140] + ("…" if len(one_line) > 140 else "")
    write_state(True, snippet, is_paused=False)

    try:
        stream_tts_to_mpv(text, voice, rate, volume)
    except (SystemExit, KeyboardInterrupt):
        pass
    except Exception as exc:
        notify("Selective Reading Error", str(exc)[:100])
    finally:
        try:
            current_pid = int(PID_FILE.read_text(encoding="utf-8").strip())
        except Exception:
            current_pid = None
        if current_pid == my_pid:
            PID_FILE.unlink(missing_ok=True)
            MPV_IPC_SOCKET.unlink(missing_ok=True)
            write_state(False, is_paused=False)


def spawn_reader(text: str, voice: str, rate: str, volume: int = 100, show_notification: bool = True) -> None:
    stop_playback(quiet=True)
    formatted = format_text_for_speech(text)
    if not formatted:
        notify("Selective Reading", "No text selected to read.")
        write_state(False, is_paused=False)
        return

    voice_name = VOICES.get(voice, {}).get("name", voice)
    one_line = re.sub(r"\s+", " ", formatted).strip()
    preview_str = one_line[:75] + ("…" if len(one_line) > 75 else "")
    if show_notification:
        notify(f"Reading ({voice_name})", preview_str)

    snippet = one_line[:140] + ("…" if len(one_line) > 140 else "")
    write_state(True, snippet, is_paused=False)

    proc = subprocess.Popen(
        [
            sys.executable,
            str(Path(__file__).resolve()),
            "_worker",
            "--voice",
            voice,
            "--rate",
            rate,
            "--volume",
            str(volume),
            "--text",
            formatted,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    PID_FILE.write_text(str(proc.pid), encoding="utf-8")


