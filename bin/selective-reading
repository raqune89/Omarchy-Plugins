                shutil.copy2(f, vdir / f.name)
"""
        subprocess.run([str(VENV_PYTHON), "-c", dl_code], check=True)

    ensure_daemon_running(show_notifications=False)


def main() -> None:
    if len(sys.argv) >= 3 and sys.argv[1] == "set-rate" and sys.argv[2] != "--":
        sys.argv.insert(2, "--")
    if "--rate" in sys.argv:
        idx = sys.argv.index("--rate")
        if idx + 1 < len(sys.argv) and sys.argv[idx + 1].startswith("-"):
            sys.argv[idx : idx + 2] = [f"--rate={sys.argv[idx + 1]}"]

    parser = argparse.ArgumentParser(prog="selective-reading", description="Selective Reading F5-TTS + GPU RVC v2 TTS controller")
    sub = parser.add_subparsers(dest="cmd")

    read_p = sub.add_parser("read", help="Read selected text or provided text")
    read_p.add_argument("--text", type=str, default=None, help="Explicit text to read")

    sub.add_parser("stop", help="Stop current playback")
    sub.add_parser("toggle", help="Toggle reading selected text / stop if playing")
    sub.add_parser("pause", help="Toggle pause / resume on current playback")
    sub.add_parser("resume", help="Resume paused playback")
    sub.add_parser("setup", help="Set up F5-TTS + RVC v2 GPU celebrity models and warm daemon")

    prev_p = sub.add_parser("preview", help="Preview a celebrity voice")
    prev_p.add_argument("voice", nargs="?", default=None, help="Voice ID to preview")

    voice_p = sub.add_parser("set-voice", help="Set preferred voice")
    voice_p.add_argument("voice", help="Voice ID")

    rate_p = sub.add_parser("set-rate", help="Set speech rate (e.g. +0%%, +15%%, -15%%)")
    rate_p.add_argument("rate", help="Rate string")

    vol_p = sub.add_parser("set-volume", help="Set playback volume (0-100 or relative +/-N)")
    vol_p.add_argument("volume", help="Volume (0-100 or +N/-N)")

    fmt_p = sub.add_parser("format", help="Preview how text will be formatted for speech")
    fmt_p.add_argument("--text", type=str, default=None, help="Explicit text to format")

    sub.add_parser("status", help="Print current JSON state")
    sub.add_parser("_daemon", help=argparse.SUPPRESS)

    worker_p = sub.add_parser("_worker")
    worker_p.add_argument("--voice", required=True)
    worker_p.add_argument("--rate", required=True)
    worker_p.add_argument("--volume", type=int, default=100)
    worker_p.add_argument("--text", required=True)

    args = parser.parse_args()
    cmd = args.cmd or "toggle"

    if cmd == "_daemon":
        run_daemon()
        return

    if cmd == "_worker":
        run_worker(args.text, args.voice, args.rate, args.volume)
        return

    if cmd == "setup":
        setup_environment(show_notifications=False)
        write_state(get_running_pid() is not None)
        print(f"F5-TTS + RVC v2 celebrity models ready in {RVC_DIR} (GPU daemon warm)")
        return

    if cmd == "stop":
        stop_playback(quiet=False)
        return

    if cmd == "pause":
        toggle_pause(force_resume=False)
        return

    if cmd == "resume":
        toggle_pause(force_resume=True)
        return

    if cmd == "format":
        txt = args.text if args.text is not None else get_selected_text()
        print(format_text_for_speech(txt))
        return

    if cmd == "toggle":
        if get_running_pid() is not None:
            stop_playback(quiet=False)
        else:
            cfg = load_config()
            txt = get_selected_text()
            spawn_reader(txt, cfg["voice"], cfg["rate"], cfg.get("volume", 100), show_notification=True)
        return

    if cmd == "read":
        cfg = load_config()
        txt = args.text if args.text is not None else get_selected_text()
        spawn_reader(txt, cfg["voice"], cfg["rate"], cfg.get("volume", 100), show_notification=True)
        return

    if cmd == "preview":
        cfg = load_config()
        voice = args.voice if args.voice in VOICES else cfg["voice"]
        if voice == "angela_giarratana":
            sample = "Hi! I am Angela Giarratana, and I am super excited to read whatever you highlight on your screen."
        elif voice == "amanda_lehan_canto":
            sample = "Hello there! I am Amanda Lehan-Canto, and I will be reading your selected text for you."
        else:
            sample = "Welcome back to Reddit stories. Today we have a thoughtful confession, and then, OH MY GOSH, the most insane update you have ever heard!"
        spawn_reader(sample, voice, cfg["rate"], cfg.get("volume", 100), show_notification=False)
        return

    if cmd == "set-voice":
        if args.voice not in VOICES:
            print(f"Unknown voice: {args.voice}", file=sys.stderr)
            sys.exit(1)
        cfg = load_config()
        cfg["voice"] = args.voice
        save_config(cfg)
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "set-rate":
        print("Selective Reading plays at natural speaker speed; speed adjustment is disabled.")
        return

    if cmd == "set-volume":
        cfg = load_config()
        cur_vol = int(cfg.get("volume", 100))
        val_str = str(args.volume).strip()
        if val_str.startswith(("+", "-")):
            try:
                delta = int(val_str)
                new_vol = max(0, min(100, cur_vol + delta))
            except ValueError:
                new_vol = cur_vol
        else:
            try:
                new_vol = max(0, min(100, int(val_str)))
            except ValueError:
                new_vol = 100

        cfg["volume"] = new_vol
        save_config(cfg)
        if get_running_pid() is not None:
            _mpv_ipc_command(["set_property", "volume", new_vol])
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "status":
        alive = get_running_pid() is not None
        st = load_state()
        if st.get("isPlaying") != alive:
            st = write_state(alive)
        print(json.dumps(st, indent=2))
        return


if __name__ == "__main__":
    main()
