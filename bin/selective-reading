    ("stephen_fry", "imbetter/stephenfry64", "StephenFry64.zip"),
    ("matthew_mcconaughey", "RoyalAce/matthew_mcconaughey_rvc_v2_48k_1.05k_epoch", "matthew_mcconaughey.7z"),
