#!/usr/bin/env python3
import argparse
from html.parser import HTMLParser
import json
import os
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
CONFIG_DIR = HOME / ".config" / "omarchy" / "selective-reading"
CONFIG_FILE = CONFIG_DIR / "config.json"
STATE_DIR = HOME / ".local" / "state" / "omarchy" / "selective-reading"
STATE_FILE = STATE_DIR / "state.json"
DATA_DIR = HOME / ".local" / "share" / "omarchy" / "selective-reading"
VENV_DIR = DATA_DIR / "venv"
VENV_PYTHON = VENV_DIR / "bin" / "python"
VOICES_DIR = DATA_DIR / "voices"

PID_FILE = Path("/tmp/selective-reading.pid")
DAEMON_PID_FILE = Path("/tmp/selective-reading-daemon.pid")
DAEMON_SOCKET = Path("/tmp/selective-reading-daemon.sock")
MPV_IPC_SOCKET = Path("/tmp/selective-reading-mpv.sock")

VOICES = {
    "morgan_freeman": {
        "name": "Morgan Freeman",
        "desc": "Deep, Iconic Narrator (US Male)",
        "lang": "en",
    },
    "stephen_fry": {
        "name": "Stephen Fry",
        "desc": "Warm, Classic Audiobook (UK Male)",
        "lang": "en",
    },
}

DEFAULT_CONFIG = {
    "voice": "morgan_freeman",
    "rate": "+0%",
}

TERMINAL_PUNCT = (".", "!", "?", ":", ";")
SOFT_TRAILING_WORDS = {
    "a", "an", "the", "and", "or", "but", "nor", "for", "yet", "so",
    "in", "on", "at", "to", "from", "by", "with", "of", "as", "into",
    "like", "through", "after", "over", "between", "out", "against",
    "during", "without", "before", "under", "around", "among", "that",
    "which", "who", "whom", "whose", "is", "are", "was", "were", "be",
}


class _StructuredHTMLParser(HTMLParser):
    HEADING_TAGS = {"h1", "h2", "h3", "h4", "h5", "h6"}
    BLOCK_TAGS = {
        "p", "div", "section", "article", "blockquote", "pre",
        "header", "footer", "main", "aside", "figcaption", "dt", "dd",
    }
    IGNORE_TAGS = {"script", "style", "noscript", "svg"}

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self._ignore_depth = 0

    def _ensure_punctuated(self) -> None:
        while self.parts and self.parts[-1] in (" ", "\t"):
            self.parts.pop()
        if not self.parts:
            return
        combined = "".join(self.parts).rstrip()
        if not combined:
            return
        last_line = combined.split("\n")[-1].strip()
        if last_line and not last_line.endswith(TERMINAL_PUNCT):
            self.parts.append(".")

    def _append_newline(self, count: int = 1) -> None:
        current = "".join(self.parts)
        trailing_nl = len(current) - len(current.rstrip("\n"))
        needed = max(0, count - trailing_nl)
        if needed > 0 and current.strip():
            self.parts.append("\n" * needed)

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        t = tag.lower()
        if t in self.IGNORE_TAGS:
            self._ignore_depth += 1
            return
        if self._ignore_depth > 0:
            return

        if t in self.HEADING_TAGS or t in self.BLOCK_TAGS or t in ("ul", "ol"):
            self._append_newline(2)
        elif t in ("li", "tr", "br", "hr"):
            self._append_newline(1)

    def handle_endtag(self, tag: str) -> None:
        t = tag.lower()
        if t in self.IGNORE_TAGS:
            self._ignore_depth = max(0, self._ignore_depth - 1)
            return
        if self._ignore_depth > 0:
            return

        if t in self.HEADING_TAGS:
            self._ensure_punctuated()
            self._append_newline(2)
        elif t == "li":
            self._ensure_punctuated()
            self._append_newline(1)
        elif t in ("td", "th"):
            self._ensure_punctuated()
            self.parts.append(" ")
        elif t == "tr":
            self._ensure_punctuated()
            self._append_newline(1)
        elif t in self.BLOCK_TAGS or t in ("ul", "ol"):
            self._append_newline(2)

    def handle_data(self, data: str) -> None:
        if self._ignore_depth > 0:
            return
        cleaned = re.sub(r"\s+", " ", data)
        if cleaned:
            self.parts.append(cleaned)

    def get_text(self) -> str:
        return "".join(self.parts).strip()


def html_to_structured_text(raw_html: str) -> str:
    parser = _StructuredHTMLParser()
    try:
        parser.feed(raw_html)
        parser.close()
        return parser.get_text()
    except Exception:
        return ""


def _ensure_sentence_end(line: str) -> str:
    s = line.strip()
    if not s:
        return ""
    if s.endswith(TERMINAL_PUNCT):
        return s
    if s.endswith(","):
        return s[:-1] + "."
    return s + "."


def _looks_like_heading(line: str, next_line: str | None) -> bool:
    s = line.strip()
    if not s or s.endswith(TERMINAL_PUNCT) or s.endswith(","):
        return False
    if next_line is None or next_line.strip() == "":
        return len(s) <= 120
    words = s.split()
    if 1 <= len(words) <= 8 and len(s) <= 65:
        last_word = re.sub(r"[^a-zA-Z]", "", words[-1]).lower()
        nxt = next_line.strip()
        if last_word not in SOFT_TRAILING_WORDS and nxt and nxt[0].isupper():
            return True
    return False


def format_text_for_speech(raw: str) -> str:
    text = raw.replace("\r\n", "\n").replace("\r", "\n")
    text = text.replace("`", "")

    raw_lines = text.split("\n")
    normalized_lines: list[tuple[str, str]] = []

    for line in raw_lines:
        stripped = re.sub(r"[ \t]+", " ", line).strip()
        if not stripped:
            normalized_lines.append(("blank", ""))
            continue

        m_head = re.match(r"^#{1,6}\s+(.*)$", stripped)
        if m_head:
            normalized_lines.append(("heading", _ensure_sentence_end(m_head.group(1))))
            continue

        m_bullet = re.match(r"^[•●◦▪▸▹–—*-]\s*(.+)$", stripped)
        if m_bullet:
            normalized_lines.append(("item", _ensure_sentence_end(m_bullet.group(1))))
            continue

        m_num = re.match(r"^(\d+)[.)]\s+(.+)$", stripped)
        if m_num:
            normalized_lines.append(("item", f"{m_num.group(1)}. {_ensure_sentence_end(m_num.group(2))}"))
            continue

        normalized_lines.append(("text", stripped))

    out_blocks: list[str] = []
    current_para: list[str] = []

    def flush_para() -> None:
        if not current_para:
            return
        joined = " ".join(current_para).strip()
        if joined:
            out_blocks.append(_ensure_sentence_end(joined))
        current_para.clear()

    n = len(normalized_lines)
    for i, (kind, content) in enumerate(normalized_lines):
        next_kind, next_content = normalized_lines[i + 1] if i + 1 < n else ("blank", "")
        prev_kind = normalized_lines[i - 1][0] if i > 0 else "blank"

        if kind == "blank":
            flush_para()
            continue

        if kind == "heading":
            flush_para()
            out_blocks.append(content)
            continue

        if kind == "item":
            flush_para()
            out_blocks.append(content)
            continue

        words = content.split()
        is_short_token = len(words) <= 4 and len(content) <= 40 and not content.endswith(TERMINAL_PUNCT)
        if is_short_token and (prev_kind in ("blank", "item") or next_kind in ("blank", "item")):
            flush_para()
            out_blocks.append(_ensure_sentence_end(content))
            continue

        if not current_para and _looks_like_heading(content, None if next_kind == "blank" else next_content):
            out_blocks.append(_ensure_sentence_end(content))
            continue

        current_para.append(content)

    flush_para()

    formatted = "\n\n".join(out_blocks).strip()
    return formatted[:15000]


def load_config() -> dict:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if CONFIG_FILE.exists():
        try:
            data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            voice = data.get("voice", DEFAULT_CONFIG["voice"])
            changed = False
            if voice not in VOICES:
                voice = DEFAULT_CONFIG["voice"]
                changed = True
            rate = data.get("rate", DEFAULT_CONFIG["rate"])
            if not re.match(r"^[+-]\d+%$", str(rate)):
                rate = DEFAULT_CONFIG["rate"]
                changed = True
            cfg = {"voice": voice, "rate": rate}
            if changed:
                save_config(cfg)
            return cfg
        except Exception:
            pass
    save_config(DEFAULT_CONFIG)
    return dict(DEFAULT_CONFIG)


def save_config(cfg: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONFIG_FILE)


def load_state() -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if STATE_FILE.exists():
        try:
            st = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            if st.get("voice") in VOICES:
                return st
        except Exception:
            pass
    cfg = load_config()
    voice_id = cfg["voice"]
    return {
        "isPlaying": False,
        "isPaused": False,
        "voice": voice_id,
        "voiceName": VOICES.get(voice_id, {}).get("name", "Morgan Freeman"),
        "rate": cfg["rate"],
        "textSnippet": "",
        "updatedAt": int(time.time()),
    }


def write_state(
    is_playing: bool,
    snippet: str | None = None,
    is_paused: bool | None = None,
) -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prev = load_state()
    cfg = load_config()
    voice_id = cfg["voice"]
    paused_val = (
        False
        if not is_playing
        else (is_paused if is_paused is not None else bool(prev.get("isPaused", False)))
    )
    state = {
        "isPlaying": is_playing,
        "isPaused": paused_val,
        "voice": voice_id,
        "voiceName": VOICES.get(voice_id, {}).get("name", "Morgan Freeman"),
        "rate": cfg["rate"],
        "textSnippet": snippet if snippet is not None else prev.get("textSnippet", ""),
        "updatedAt": int(time.time()),
    }
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    tmp.replace(STATE_FILE)
    return state


def notify(title: str, body: str) -> None:
    try:
        subprocess.run(
            [
                "notify-send",
                "-a",
                "Selective Reading",
                "-t",
                "2500",
                "-h",
                "string:x-canonical-private-synchronous:selective-reading",
                title,
                body,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except Exception:
        pass


def get_running_pid(pid_file: Path = PID_FILE) -> int | None:
    if not pid_file.exists():
        return None
    try:
        pid = int(pid_file.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        try:
            pid_file.unlink(missing_ok=True)
        except Exception:
            pass
        return None


def _mpv_ipc_command(cmd_list: list) -> dict | None:
    for _ in range(20):
        if MPV_IPC_SOCKET.exists():
            break
        time.sleep(0.025)
    if not MPV_IPC_SOCKET.exists():
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1.0)
            sock.connect(str(MPV_IPC_SOCKET))
            payload = (json.dumps({"command": cmd_list}) + "\n").encode("utf-8")
            sock.sendall(payload)
            resp = b""
            while b"\n" not in resp:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                resp += chunk
            for line in resp.decode("utf-8", errors="ignore").splitlines():
                line = line.strip()
                if not line:
                    continue
                data = json.loads(line)
                if "error" in data:
                    return data
    except Exception:
        return None
    return None


def toggle_pause(force_resume: bool = False) -> bool:
    pid = get_running_pid()
    if pid is None:
        write_state(False, is_paused=False)
        notify("Selective Reading", "No active reading to pause.")
        return False

    st = load_state()
    currently_paused = bool(st.get("isPaused", False))
    if force_resume and not currently_paused:
        notify("Selective Reading", "Already playing")
        return True

    target_paused = False if force_resume else (not currently_paused)

    resp = _mpv_ipc_command(["set_property", "pause", target_paused])
    if resp is None or resp.get("error") != "success":
        sig = signal.SIGSTOP if target_paused else signal.SIGCONT
        try:
            os.killpg(os.getpgid(pid), sig)
        except Exception:
            try:
                os.kill(pid, sig)
            except Exception:
                pass

    write_state(True, is_paused=target_paused)
    if target_paused:
        notify("Selective Reading", "Paused reading (SUPER + R to resume)")
    else:
        notify("Selective Reading", "Resumed reading")
    return True


def stop_playback(quiet: bool = False) -> bool:
    pid = get_running_pid()
    was_running = False
    if pid is not None:
        was_running = True
        try:
            pgid = os.getpgid(pid)
            os.killpg(pgid, signal.SIGCONT)
            os.killpg(pgid, signal.SIGTERM)
        except Exception:
            try:
                os.kill(pid, signal.SIGCONT)
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
        for _ in range(10):
            try:
                os.kill(pid, 0)
                time.sleep(0.03)
            except ProcessLookupError:
                break
            except Exception:
                break
        try:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
        except Exception:
            pass
    try:
        PID_FILE.unlink(missing_ok=True)
    except Exception:
        pass
    try:
        MPV_IPC_SOCKET.unlink(missing_ok=True)
    except Exception:
        pass
    write_state(False, is_paused=False)
    if was_running and not quiet:
        notify("Selective Reading", "Stopped reading")
    return was_running


def _fingerprint(s: str) -> str:
    return re.sub(r"\W+", "", s).lower()[:160]


def get_selected_text() -> str:
    for extra_args in (["--primary"], []):
        plain = ""
        try:
            res = subprocess.run(
                ["wl-paste", *extra_args, "--no-newline"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                plain = res.stdout.strip()
        except Exception:
            pass

        if not plain:
            continue

        try:
            types_res = subprocess.run(
                ["wl-paste", *extra_args, "--list-types"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=1,
                check=False,
            )
            if types_res.returncode == 0 and "text/html" in types_res.stdout.splitlines():
                html_res = subprocess.run(
                    ["wl-paste", *extra_args, "--type", "text/html", "--no-newline"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=2,
                    check=False,
                )
                if html_res.returncode == 0 and html_res.stdout.strip():
                    structured = html_to_structured_text(html_res.stdout)
                    if structured and _fingerprint(structured) == _fingerprint(plain):
                        return structured
        except Exception:
            pass

        return plain
    return ""


def rate_to_speed(rate: str) -> float:
    m = re.match(r"^([+-]?\d+)%$", str(rate).strip())
    if not m:
        return 1.0
    pct = int(m.group(1))
    return max(0.5, min(2.0, 1.0 + (pct / 100.0)))


def _daemon_is_ready() -> bool:
    if not DAEMON_SOCKET.exists():
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(str(DAEMON_SOCKET))
            s.sendall((json.dumps({"cmd": "ping"}) + "\n").encode("utf-8"))
            resp = s.recv(64)
            return b"pong" in resp
    except Exception:
        return False


def ensure_daemon_running(show_notifications: bool = True) -> bool:
    if _daemon_is_ready():
        return True

    if not VENV_PYTHON.exists():
        if show_notifications:
            notify("Selective Reading", "Running first-time voice cloning setup…")
        setup_environment(show_notifications=show_notifications)

    if get_running_pid(DAEMON_PID_FILE) is None:
        if show_notifications:
            notify("Selective Reading", "Warming up GPU voice-cloning engine…")
        proc = subprocess.Popen(
            [str(VENV_PYTHON), str(Path(__file__).resolve()), "_daemon"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        DAEMON_PID_FILE.write_text(str(proc.pid), encoding="utf-8")

    for _ in range(180):
        if _daemon_is_ready():
            return True
        time.sleep(0.25)
    return False


def _find_xtts_snapshot_dir() -> Path | None:
    hf_dir = HOME / ".cache" / "huggingface" / "hub" / "models--tts-hub--XTTS-v2" / "snapshots"
    if hf_dir.exists():
        snaps = sorted(p for p in hf_dir.iterdir() if (p / "model.pth").exists() and (p / "config.json").exists())
        if snaps:
            return snaps[-1]
    return None


def run_daemon() -> None:
    os.environ["COQUI_TOS_AGREED"] = "1"
    import numpy as np
    import torch
    from TTS.tts.configs.xtts_config import XttsConfig
    from TTS.tts.models.xtts import Xtts
    from TTS.utils.manage import ModelManager

    my_pid = os.getpid()
    DAEMON_PID_FILE.write_text(str(my_pid), encoding="utf-8")

    try:
        DAEMON_SOCKET.unlink(missing_ok=True)
    except Exception:
        pass

    model_dir = _find_xtts_snapshot_dir()
    if model_dir is None:
        manager = ModelManager()
        model_path, _, _ = manager.download_model("tts_models/multilingual/multi-dataset/xtts_v2")
        model_dir = Path(model_path) if Path(model_path).is_dir() else Path(model_path).parent

    device = "cuda" if torch.cuda.is_available() else "cpu"
    config = XttsConfig()
    config.load_json(str(model_dir / "config.json"))
    model = Xtts(config)
    model.load_checkpoint(config, checkpoint_dir=str(model_dir), eval=True)
    model.to(device)

    latents_cache: dict[str, tuple[torch.Tensor, torch.Tensor]] = {}

    def get_voice_latents(voice_id: str) -> tuple[torch.Tensor, torch.Tensor]:
        pt_file = VOICES_DIR / f"{voice_id}.pt"
        wav_file = VOICES_DIR / f"{voice_id}.wav"
        if voice_id in latents_cache:
            return latents_cache[voice_id]
        if pt_file.exists():
            data = torch.load(pt_file, map_location=device, weights_only=True)
            pair = (data["gpt_cond_latent"].to(device), data["speaker_embedding"].to(device))
            latents_cache[voice_id] = pair
            return pair
        if wav_file.exists():
            gpt_cond_latent, speaker_embedding = model.get_conditioning_latents(
                audio_path=[str(wav_file)],
                gpt_cond_len=30,
                gpt_cond_chunk_len=6,
                max_ref_length=30,
            )
            torch.save(
                {
                    "gpt_cond_latent": gpt_cond_latent.cpu(),
                    "speaker_embedding": speaker_embedding.cpu(),
                },
                pt_file,
            )
            pair = (gpt_cond_latent.to(device), speaker_embedding.to(device))
            latents_cache[voice_id] = pair
            return pair
        raise FileNotFoundError(f"Missing voice reference for {voice_id}")

    for vid in VOICES:
        try:
            get_voice_latents(vid)
        except Exception:
            pass

    # Warm up CUDA kernels so first user request starts in ~250ms
    if latents_cache:
        first_vid = next(iter(latents_cache))
        g_lat, s_emb = latents_cache[first_vid]
        try:
            with torch.inference_mode():
                for _ in model.inference_stream("Ready.", "en", g_lat, s_emb, stream_chunk_size=20):
                    break
        except Exception:
            pass

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(DAEMON_SOCKET))
    server.listen(4)

    def cleanup_and_exit(signum, frame):
        try:
            server.close()
        except Exception:
            pass
        try:
            DAEMON_SOCKET.unlink(missing_ok=True)
        except Exception:
            pass
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, cleanup_and_exit)
    signal.signal(signal.SIGINT, cleanup_and_exit)

    while True:
        conn, _ = server.accept()
        with conn:
            try:
                buf = b""
                while b"\n" not in buf:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    buf += chunk
                if not buf:
                    continue
                req = json.loads(buf.decode("utf-8").splitlines()[0])
                cmd = req.get("cmd")
                if cmd == "ping":
                    conn.sendall(b"pong\n")
                    continue
                if cmd == "reload_voice":
                    vid = req.get("voice", "")
                    latents_cache.pop(vid, None)
                    get_voice_latents(vid)
                    conn.sendall(b"ok\n")
                    continue
                if cmd != "stream":
                    continue

                text = str(req.get("text", "")).strip()
                voice = str(req.get("voice", DEFAULT_CONFIG["voice"]))
                speed = float(req.get("speed", 1.0))
                if voice not in VOICES:
                    voice = DEFAULT_CONFIG["voice"]

                gpt_cond_latent, speaker_embedding = get_voice_latents(voice)
                blocks = [b.strip() for b in text.split("\n\n") if b.strip()]
                silence_pcm = np.zeros(int(24000 * 0.38), dtype="<f4").tobytes()

                with torch.inference_mode():
                    for idx, block in enumerate(blocks):
                        stream = model.inference_stream(
                            block,
                            VOICES[voice]["lang"],
                            gpt_cond_latent,
                            speaker_embedding,
                            speed=speed,
                            stream_chunk_size=20,
                            enable_text_splitting=True,
                        )
                        for audio_chunk in stream:
                            pcm = audio_chunk.detach().cpu().numpy().astype("<f4").tobytes()
                            conn.sendall(pcm)
                        if idx < len(blocks) - 1:
                            conn.sendall(silence_pcm)
            except (BrokenPipeError, ConnectionResetError):
                continue
            except Exception:
                continue


def stream_tts_to_mpv(text: str, voice: str, rate: str) -> None:
    try:
        MPV_IPC_SOCKET.unlink(missing_ok=True)
    except Exception:
        pass

    if not ensure_daemon_running(show_notifications=True):
        raise RuntimeError("GPU TTS daemon failed to start")

    speed = rate_to_speed(rate)

    mpv_proc = subprocess.Popen(
        [
            "mpv",
            "--no-video",
            "--really-quiet",
            "--no-terminal",
            "--title=Selective Reading",
            "--demuxer=rawaudio",
            "--demuxer-rawaudio-rate=24000",
            "--demuxer-rawaudio-channels=1",
            "--demuxer-rawaudio-format=floatle",
            "--cache=yes",
            "--demuxer-max-bytes=100MiB",
            f"--input-ipc-server={MPV_IPC_SOCKET}",
            "-",
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(str(DAEMON_SOCKET))
            req = {"cmd": "stream", "text": text, "voice": voice, "speed": speed}
            sock.sendall((json.dumps(req) + "\n").encode("utf-8"))
            while mpv_proc.poll() is None:
                data = sock.recv(16384)
                if not data:
                    break
                if mpv_proc.stdin:
                    try:
                        mpv_proc.stdin.write(data)
                        mpv_proc.stdin.flush()
                    except (BrokenPipeError, OSError):
                        break
        if mpv_proc.stdin:
            try:
                mpv_proc.stdin.close()
            except Exception:
                pass
        mpv_proc.wait()
    finally:
        if mpv_proc.poll() is None:
            mpv_proc.terminate()
            try:
                mpv_proc.wait(timeout=1)
            except Exception:
                mpv_proc.kill()
        try:
            MPV_IPC_SOCKET.unlink(missing_ok=True)
        except Exception:
            pass


def run_worker(text: str, voice: str, rate: str) -> None:
    my_pid = os.getpid()
    PID_FILE.write_text(str(my_pid), encoding="utf-8")

    def handle_sig(signum, frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)

    one_line = re.sub(r"\s+", " ", text).strip()
    snippet = one_line[:140] + ("…" if len(one_line) > 140 else "")
    write_state(True, snippet, is_paused=False)

    try:
        stream_tts_to_mpv(text, voice, rate)
    except (SystemExit, KeyboardInterrupt):
        pass
    except Exception as exc:
        notify("Selective Reading Error", str(exc)[:100])
    finally:
        try:
            current_pid = int(PID_FILE.read_text(encoding="utf-8").strip())
        except Exception:
            current_pid = None
        if current_pid == my_pid:
            PID_FILE.unlink(missing_ok=True)
            MPV_IPC_SOCKET.unlink(missing_ok=True)
            write_state(False, is_paused=False)


def spawn_reader(text: str, voice: str, rate: str, show_notification: bool = True) -> None:
    stop_playback(quiet=True)
    formatted = format_text_for_speech(text)
    if not formatted:
        notify("Selective Reading", "No text selected to read.")
        write_state(False, is_paused=False)
        return

    voice_name = VOICES.get(voice, {}).get("name", voice)
    one_line = re.sub(r"\s+", " ", formatted).strip()
    preview_str = one_line[:75] + ("…" if len(one_line) > 75 else "")
    if show_notification:
        notify(f"Reading ({voice_name})", preview_str)

    snippet = one_line[:140] + ("…" if len(one_line) > 140 else "")
    write_state(True, snippet, is_paused=False)

    proc = subprocess.Popen(
        [
            sys.executable,
            str(Path(__file__).resolve()),
            "_worker",
            "--voice",
            voice,
            "--rate",
            rate,
            "--text",
            formatted,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    PID_FILE.write_text(str(proc.pid), encoding="utf-8")


def _prepare_default_voice_samples() -> None:
    VOICES_DIR.mkdir(parents=True, exist_ok=True)
    mf_wav = VOICES_DIR / "morgan_freeman.wav"
    sf_wav = VOICES_DIR / "stephen_fry.wav"

    if not mf_wav.exists() or mf_wav.stat().st_size < 10000:
        with tempfile.TemporaryDirectory() as tmpdir:
            raw_out = Path(tmpdir) / "mf_raw.wav"
            subprocess.run(
                [
                    "yt-dlp",
                    "-x",
                    "--audio-format",
                    "wav",
                    "-o",
                    str(Path(tmpdir) / "mf_raw.%(ext)s"),
                    "https://www.youtube.com/watch?v=-fL17_6Zocs",
                ],
                check=True,
            )
            subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-i",
                    str(raw_out),
                    "-filter_complex",
                    "[0:a]atrim=start=2.95:end=12.15,asetpts=PTS-STARTPTS[a1];"
                    "[0:a]atrim=start=14.55:end=19.25,asetpts=PTS-STARTPTS[a2];"
                    "[0:a]atrim=start=26.10:end=35.40,asetpts=PTS-STARTPTS[a3];"
                    "[a1][a2][a3]concat=n=3:v=0:a=1,highpass=f=75,loudnorm=I=-16:TP=-1.5:LRA=11[out]",
                    "-map",
                    "[out]",
                    "-ac",
                    "1",
                    "-ar",
                    "24000",
                    "-c:a",
                    "pcm_s16le",
                    str(mf_wav),
                ],
                check=True,
            )

    if not sf_wav.exists() or sf_wav.stat().st_size < 10000:
        subprocess.run(
            [
                str(VENV_PYTHON),
                "-c",
                "from huggingface_hub import hf_hub_download; import subprocess, os; "
                "segs = [hf_hub_download(repo_id='smfreeze/50-words-stephen-fry', filename=f'segment_{i}.mp3', repo_type='dataset') for i in (1, 2, 3)]; "
                "inputs = [arg for s in segs for arg in ('-i', s)]; "
                "subprocess.run(['ffmpeg', '-y', *inputs, '-filter_complex', '[0:a][1:a][2:a]concat=n=3:v=0:a=1,highpass=f=75,loudnorm=I=-16:TP=-1.5:LRA=11[out]', '-map', '[out]', '-ac', '1', '-ar', '24000', '-c:a', 'pcm_s16le', os.path.expanduser('~/.local/share/omarchy/selective-reading/voices/stephen_fry.wav')], check=True)",
            ],
            check=True,
        )


def _compute_latents_in_venv(voice_ids: list[str]) -> None:
    code = """
import os, sys, torch
from pathlib import Path
from TTS.tts.configs.xtts_config import XttsConfig
from TTS.tts.models.xtts import Xtts
from TTS.utils.manage import ModelManager

os.environ["COQUI_TOS_AGREED"] = "1"
voices_dir = Path.home() / ".local/share/omarchy/selective-reading/voices"
hf_dir = Path.home() / ".cache/huggingface/hub/models--tts-hub--XTTS-v2/snapshots"
model_dir = None
if hf_dir.exists():
    snaps = sorted(p for p in hf_dir.iterdir() if (p / "model.pth").exists())
    if snaps:
        model_dir = snaps[-1]
if model_dir is None:
    manager = ModelManager()
    mp, _, _ = manager.download_model("tts_models/multilingual/multi-dataset/xtts_v2")
    model_dir = Path(mp) if Path(mp).is_dir() else Path(mp).parent

device = "cuda" if torch.cuda.is_available() else "cpu"
config = XttsConfig()
config.load_json(str(model_dir / "config.json"))
model = Xtts(config)
model.load_checkpoint(config, checkpoint_dir=str(model_dir), eval=True)
model.to(device)

for vid in sys.argv[1:]:
    wav_path = voices_dir / f"{vid}.wav"
    pt_path = voices_dir / f"{vid}.pt"
    if not wav_path.exists():
        continue
    gpt_cond_latent, speaker_embedding = model.get_conditioning_latents(
        audio_path=[str(wav_path)],
        gpt_cond_len=30,
        gpt_cond_chunk_len=6,
        max_ref_length=30,
    )
    torch.save({
        "gpt_cond_latent": gpt_cond_latent.cpu(),
        "speaker_embedding": speaker_embedding.cpu(),
    }, pt_path)
    print(f"Computed speaker latents: {pt_path}")
"""
    subprocess.run([str(VENV_PYTHON), "-c", code, *voice_ids], check=True)


def setup_environment(show_notifications: bool = False) -> None:
    VOICES_DIR.mkdir(parents=True, exist_ok=True)
    if not VENV_PYTHON.exists():
        if show_notifications:
            notify("Selective Reading", "Creating Python 3.12 GPU voice-cloning environment…")
        subprocess.run(
            ["uv", "venv", "--python", "3.12", str(VENV_DIR), "--allow-existing"],
            check=True,
        )
        subprocess.run(
            [
                "uv",
                "pip",
                "install",
                "--python",
                str(VENV_PYTHON),
                "coqui-tts[codec]>=0.25.0",
                "torch",
                "torchaudio",
                "numpy",
                "soundfile",
                "six",
            ],
            check=True,
        )

    _prepare_default_voice_samples()
    missing_latents = [
        vid for vid in VOICES if not (VOICES_DIR / f"{vid}.pt").exists()
    ]
    if missing_latents or _find_xtts_snapshot_dir() is None:
        if show_notifications:
            notify("Selective Reading", "Computing GPU voice latents for Morgan Freeman & Stephen Fry…")
        _compute_latents_in_venv(list(VOICES.keys()))

    ensure_daemon_running(show_notifications=False)


def clone_voice_from_source(voice_id: str, source: str, start_sec: float = 0.0, duration_sec: float = 25.0) -> None:
    if voice_id not in VOICES:
        print(f"Unsupported voice ID '{voice_id}'. Choose from: {', '.join(VOICES)}", file=sys.stderr)
        sys.exit(1)

    setup_environment(show_notifications=False)
    dest_wav = VOICES_DIR / f"{voice_id}.wav"
    dest_pt = VOICES_DIR / f"{voice_id}.pt"

    with tempfile.TemporaryDirectory() as tmpdir:
        src_path = Path(source).expanduser()
        if not src_path.exists() and (source.startswith("http://") or source.startswith("https://")):
            dl_out = Path(tmpdir) / "downloaded.wav"
            subprocess.run(
                [
                    "yt-dlp",
                    "-x",
                    "--audio-format",
                    "wav",
                    "-o",
                    str(Path(tmpdir) / "downloaded.%(ext)s"),
                    source,
                ],
                check=True,
            )
            src_path = dl_out

        if not src_path.exists():
            print(f"Audio source not found: {source}", file=sys.stderr)
            sys.exit(1)

        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-ss",
                str(start_sec),
                "-t",
                str(duration_sec),
                "-i",
                str(src_path),
                "-af",
                "highpass=f=75,loudnorm=I=-16:TP=-1.5:LRA=11",
                "-ac",
                "1",
                "-ar",
                "24000",
                "-c:a",
                "pcm_s16le",
                str(dest_wav),
            ],
            check=True,
        )

    dest_pt.unlink(missing_ok=True)
    _compute_latents_in_venv([voice_id])

    if _daemon_is_ready():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(5.0)
                s.connect(str(DAEMON_SOCKET))
                s.sendall((json.dumps({"cmd": "reload_voice", "voice": voice_id}) + "\n").encode("utf-8"))
                s.recv(64)
        except Exception:
            pass
    print(f"Updated cloned voice '{voice_id}' ({VOICES[voice_id]['name']}) -> {dest_pt}")


def main() -> None:
    if len(sys.argv) >= 3 and sys.argv[1] == "set-rate" and sys.argv[2] != "--":
        sys.argv.insert(2, "--")
    if "--rate" in sys.argv:
        idx = sys.argv.index("--rate")
        if idx + 1 < len(sys.argv) and sys.argv[idx + 1].startswith("-"):
            sys.argv[idx : idx + 2] = [f"--rate={sys.argv[idx + 1]}"]

    parser = argparse.ArgumentParser(prog="selective-reading", description="Selective Reading GPU Zero-Shot Voice Cloning TTS controller")
    sub = parser.add_subparsers(dest="cmd")

    read_p = sub.add_parser("read", help="Read selected text or provided text")
    read_p.add_argument("--text", type=str, default=None, help="Explicit text to read")

    sub.add_parser("stop", help="Stop current playback")
    sub.add_parser("toggle", help="Toggle reading selected text / stop if playing")
    sub.add_parser("pause", help="Toggle pause / resume on current playback")
    sub.add_parser("resume", help="Resume paused playback")
    sub.add_parser("setup", help="Set up XTTS-v2 GPU voice cloning models and warm daemon")

    clone_p = sub.add_parser("clone-voice", help="Re-clone a voice from a local audio file or URL")
    clone_p.add_argument("voice", choices=list(VOICES.keys()), help="Voice ID to update")
    clone_p.add_argument("source", help="Path to audio file (.wav/.mp3) or video/audio URL")
    clone_p.add_argument("--start", type=float, default=0.0, help="Start offset in seconds (default: 0)")
    clone_p.add_argument("--duration", type=float, default=25.0, help="Clip duration in seconds (default: 25)")

    prev_p = sub.add_parser("preview", help="Preview a cloned voice")
    prev_p.add_argument("voice", nargs="?", default=None, help="Voice ID to preview")

    voice_p = sub.add_parser("set-voice", help="Set preferred voice")
    voice_p.add_argument("voice", help="Voice ID")

    rate_p = sub.add_parser("set-rate", help="Set speech rate (e.g. +0%%, +15%%, -15%%)")
    rate_p.add_argument("rate", help="Rate string")

    fmt_p = sub.add_parser("format", help="Preview how text will be formatted for speech")
    fmt_p.add_argument("--text", type=str, default=None, help="Explicit text to format")

    sub.add_parser("status", help="Print current JSON state")
    sub.add_parser("_daemon", help=argparse.SUPPRESS)

    worker_p = sub.add_parser("_worker")
    worker_p.add_argument("--voice", required=True)
    worker_p.add_argument("--rate", required=True)
    worker_p.add_argument("--text", required=True)

    args = parser.parse_args()
    cmd = args.cmd or "toggle"

    if cmd == "_daemon":
        run_daemon()
        return

    if cmd == "_worker":
        run_worker(args.text, args.voice, args.rate)
        return

    if cmd == "setup":
        setup_environment(show_notifications=False)
        write_state(get_running_pid() is not None)
        print(f"XTTS-v2 celebrity voices ready in {VOICES_DIR} (GPU daemon warm)")
        return

    if cmd == "clone-voice":
        clone_voice_from_source(args.voice, args.source, args.start, args.duration)
        return

    if cmd == "stop":
        stop_playback(quiet=False)
        return

    if cmd == "pause":
        toggle_pause(force_resume=False)
        return

    if cmd == "resume":
        toggle_pause(force_resume=True)
        return

    if cmd == "format":
        txt = args.text if args.text is not None else get_selected_text()
        print(format_text_for_speech(txt))
        return

    if cmd == "toggle":
        if get_running_pid() is not None:
            stop_playback(quiet=False)
        else:
            cfg = load_config()
            txt = get_selected_text()
            spawn_reader(txt, cfg["voice"], cfg["rate"], show_notification=True)
        return

    if cmd == "read":
        cfg = load_config()
        txt = args.text if args.text is not None else get_selected_text()
        spawn_reader(txt, cfg["voice"], cfg["rate"], show_notification=True)
        return

    if cmd == "preview":
        cfg = load_config()
        voice = args.voice if args.voice in VOICES else cfg["voice"]
        vname = VOICES[voice]["name"]
        if voice == "morgan_freeman":
            sample = "Hello. I am Morgan Freeman, and I will be narrating your selected text."
        else:
            sample = "Hello there! I am Stephen Fry, ready to read whatever you highlight on your screen."
        spawn_reader(sample, voice, cfg["rate"], show_notification=False)
        return

    if cmd == "set-voice":
        if args.voice not in VOICES:
            print(f"Unknown voice: {args.voice}", file=sys.stderr)
            sys.exit(1)
        cfg = load_config()
        cfg["voice"] = args.voice
        save_config(cfg)
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "set-rate":
        rate_val = args.rate.strip()
        if not rate_val.startswith(("+", "-")):
            rate_val = "+" + rate_val
        if not rate_val.endswith("%"):
            rate_val += "%"
        cfg = load_config()
        cfg["rate"] = rate_val
        save_config(cfg)
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "status":
        alive = get_running_pid() is not None
        st = load_state()
        if st.get("isPlaying") != alive:
            st = write_state(alive)
        print(json.dumps(st, indent=2))
        return


if __name__ == "__main__":
    main()
