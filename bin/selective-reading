    if not site_pkgs:
        return
    infer_dir = site_pkgs[0]
    mod_file = infer_dir / "modules.py"
    if mod_file.exists():
        txt = mod_file.read_text(encoding="utf-8")
        if "from fairseq import checkpoint_utils" in txt:
            txt = txt.replace(
                "from fairseq import checkpoint_utils\nimport soundfile",
                "import soundfile\nfrom pathlib import Path\nfrom transformers import HubertModel",
            )
            old_load = """def download_models():
    hf_hub_download("lj1995/VoiceConversionWebUI", "hubert_base.pt")
    hf_hub_download("lj1995/VoiceConversionWebUI", "rmvpe.pt")


def load_hubert(config):
    fl = hf_hub_download("lj1995/VoiceConversionWebUI", "hubert_base.pt")
    models, _, _ = checkpoint_utils.load_model_ensemble_and_task(
        [fl],
        suffix="",
    )
    hubert_model = models[0]
    hubert_model = hubert_model.to(config.device)
    if config.is_half:
        hubert_model = hubert_model.half()
    else:
        hubert_model = hubert_model.float()
    return hubert_model.eval()"""
            new_load = """class _TransformersHubertWrapper(torch.nn.Module):
    def __init__(self, hf_model, final_proj):
        super().__init__()
        self.model = hf_model
        self.final_proj = final_proj

    def extract_features(self, source, padding_mask=None, output_layer=12):
        out = self.model(source, output_hidden_states=True)
        return (out.hidden_states[output_layer],)


def download_models():
