                ftxt = re.sub(r"torch\.load\(([^)]+)\)", r"torch.load(\1, weights_only=False)", ftxt)
                fpath.write_text(ftxt, encoding="utf-8")

    cfg_py = infer_dir / "configs" / "config.py"
    if cfg_py.exists():
