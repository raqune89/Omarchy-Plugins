vocos_dir = f5_dir / "vocos"
rvc_dir = data_dir / "rvc_models"
f5_dir.mkdir(parents=True, exist_ok=True)
vocos_dir.mkdir(parents=True, exist_ok=True)
rvc_dir.mkdir(parents=True, exist_ok=True)

ckpt = hf_hub_download("SWivid/F5-TTS", "F5TTS_v1_Base/model_1250000.safetensors")
shutil.copy2(ckpt, f5_dir / "model_1250000.safetensors")
for fname in ("config.yaml", "pytorch_model.bin"):
    vf = hf_hub_download("charactr/vocos-mel-24khz", fname)
    shutil.copy2(vf, vocos_dir / fname)

rmvpe_f = hf_hub_download("lj1995/VoiceConversionWebUI", "rmvpe.pt")
shutil.copy2(rmvpe_f, rvc_dir / "rmvpe.pt")
hb_dir = rvc_dir / "hubert_base"
hb_dir.mkdir(parents=True, exist_ok=True)
for fname in ("config.json", "preprocessor_config.json", "pytorch_model.bin"):
    f = hf_hub_download("lj1995/VoiceConversionWebUI", f"hubert_base/{fname}")
    shutil.copy2(f, hb_dir / fname)

