                'audio, (self.t_pad, self.t_pad), mode="reflect"',
                'audio, (self.t_pad, self.t_pad), mode="reflect" if audio.shape[-1] > self.t_pad else "constant"',
            )
        pipe_py.write_text(ptxt, encoding="utf-8")

    f5_pkgs = list(VENV_DIR.glob("lib/python*/site-packages/f5_tts/model/__init__.py"))
    if f5_pkgs:
        f5_init = f5_pkgs[0]
        itxt = f5_init.read_text(encoding="utf-8")
        if "from f5_tts.model.trainer import Trainer" in itxt and "# from f5_tts.model.trainer import Trainer" not in itxt:
            itxt = itxt.replace("from f5_tts.model.trainer import Trainer", "# from f5_tts.model.trainer import Trainer")
            f5_init.write_text(itxt, encoding="utf-8")


def setup_environment(show_notifications: bool = False) -> None:
    MODEL_DIR.mkdir(parents=True, exist_ok=True)
    F5_DIR.mkdir(parents=True, exist_ok=True)
    F5_VOCOS_DIR.mkdir(parents=True, exist_ok=True)
    VOICES_DIR.mkdir(parents=True, exist_ok=True)
    RVC_DIR.mkdir(parents=True, exist_ok=True)

    # 1. Ensure Python 3.12 GPU venv and F5-TTS + RVC dependencies exist
    if not VENV_PYTHON.exists():
        if show_notifications:
            notify("Selective Reading", "Creating Python 3.12 GPU F5-TTS + RVC v2 environment…")
        subprocess.run(["uv", "venv", "--python", "3.12", str(VENV_DIR), "--allow-existing"], check=True)
        subprocess.run(
            [
                "uv",
                "pip",
                "install",
                "--python",
                str(VENV_PYTHON),
                "torch",
                "torchaudio",
                "transformers",
                "huggingface-hub",
                "faiss-cpu",
                "torchcrepe",
                "pyworld",
                "praat-parselmouth",
                "soundfile",
                "librosa",
                "scipy",
                "vocos",
                "x-transformers",
                "torchdiffeq",
                "ema-pytorch",
                "cached-path",
                "pypinyin",
                "rjieba",
                "unidecode",
                "tomli",
                "pydub",
                "accelerate",
                "hydra-core",
                "omegaconf",
                "setuptools<81",
            ],
            check=True,
        )
        subprocess.run(
            ["uv", "pip", "install", "--python", str(VENV_PYTHON), "--no-deps", "inferrvc", "f5-tts"],
            check=True,
        )

    _patch_inferrvc_in_venv()

    # 2. Download F5-TTS v1 Base + Vocos + RVC v2 models if missing
    missing_models = (
        not F5_CKPT_FILE.exists()
        or not (F5_VOCOS_DIR / "pytorch_model.bin").exists()
        or any(not (RVC_DIR / vid / vinfo["pth_name"]).exists() for vid, vinfo in VOICES.items() if vinfo.get("pth_name"))
    )
    if missing_models:
        if show_notifications:
            notify("Selective Reading", "Downloading F5-TTS + RVC v2 celebrity models…")
        dl_code = """
import shutil, subprocess, tempfile
from pathlib import Path
from huggingface_hub import hf_hub_download

data_dir = Path.home() / ".local/share/omarchy/selective-reading"
f5_dir = data_dir / "models/f5_tts"
vocos_dir = f5_dir / "vocos"
rvc_dir = data_dir / "rvc_models"
f5_dir.mkdir(parents=True, exist_ok=True)
vocos_dir.mkdir(parents=True, exist_ok=True)
rvc_dir.mkdir(parents=True, exist_ok=True)

ckpt = hf_hub_download("SWivid/F5-TTS", "F5TTS_v1_Base/model_1250000.safetensors")
shutil.copy2(ckpt, f5_dir / "model_1250000.safetensors")
for fname in ("config.yaml", "pytorch_model.bin"):
    vf = hf_hub_download("charactr/vocos-mel-24khz", fname)
    shutil.copy2(vf, vocos_dir / fname)

rmvpe_f = hf_hub_download("lj1995/VoiceConversionWebUI", "rmvpe.pt")
shutil.copy2(rmvpe_f, rvc_dir / "rmvpe.pt")
hb_dir = rvc_dir / "hubert_base"
hb_dir.mkdir(parents=True, exist_ok=True)
for fname in ("config.json", "preprocessor_config.json", "pytorch_model.bin"):
    f = hf_hub_download("lj1995/VoiceConversionWebUI", f"hubert_base/{fname}")
    shutil.copy2(f, hb_dir / fname)

models = [
    ("morgan_freeman", "Supanovah/MorganFreeman", "MorganFreeman_e440_s4840.zip"),
    ("stephen_fry", "imbetter/stephenfry64", "StephenFry64.zip"),
    ("matthew_mcconaughey", "RoyalAce/matthew_mcconaughey_rvc_v2_48k_1.05k_epoch", "matthew_mcconaughey.7z"),
]
for vid, repo, zname in models:
    vdir = rvc_dir / vid
    vdir.mkdir(parents=True, exist_ok=True)
    zpath = hf_hub_download(repo, zname)
    with tempfile.TemporaryDirectory() as tmpdir:
        subprocess.run(["bsdtar", "-xf", zpath, "-C", tmpdir], check=True)
        for f in Path(tmpdir).rglob("*"):
            if f.is_file() and f.suffix in (".pth", ".index") and not f.name.startswith("."):
                shutil.copy2(f, vdir / f.name)
"""
        subprocess.run([str(VENV_PYTHON), "-c", dl_code], check=True)

    ensure_daemon_running(show_notifications=False)


def main() -> None:
    if len(sys.argv) >= 3 and sys.argv[1] == "set-rate" and sys.argv[2] != "--":
        sys.argv.insert(2, "--")
    if "--rate" in sys.argv:
        idx = sys.argv.index("--rate")
        if idx + 1 < len(sys.argv) and sys.argv[idx + 1].startswith("-"):
            sys.argv[idx : idx + 2] = [f"--rate={sys.argv[idx + 1]}"]

    parser = argparse.ArgumentParser(prog="selective-reading", description="Selective Reading F5-TTS + GPU RVC v2 TTS controller")
    sub = parser.add_subparsers(dest="cmd")

    read_p = sub.add_parser("read", help="Read selected text or provided text")
    read_p.add_argument("--text", type=str, default=None, help="Explicit text to read")

    sub.add_parser("stop", help="Stop current playback")
    sub.add_parser("toggle", help="Toggle reading selected text / stop if playing")
    sub.add_parser("pause", help="Toggle pause / resume on current playback")
    sub.add_parser("resume", help="Resume paused playback")
    sub.add_parser("setup", help="Set up F5-TTS + RVC v2 GPU celebrity models and warm daemon")

    prev_p = sub.add_parser("preview", help="Preview a celebrity voice")
    prev_p.add_argument("voice", nargs="?", default=None, help="Voice ID to preview")

    voice_p = sub.add_parser("set-voice", help="Set preferred voice")
    voice_p.add_argument("voice", help="Voice ID")

    rate_p = sub.add_parser("set-rate", help="Set speech rate (e.g. +0%%, +15%%, -15%%)")
    rate_p.add_argument("rate", help="Rate string")

    vol_p = sub.add_parser("set-volume", help="Set playback volume (0-100 or relative +/-N)")
    vol_p.add_argument("volume", help="Volume (0-100 or +N/-N)")

    fmt_p = sub.add_parser("format", help="Preview how text will be formatted for speech")
    fmt_p.add_argument("--text", type=str, default=None, help="Explicit text to format")

    sub.add_parser("status", help="Print current JSON state")
    sub.add_parser("_daemon", help=argparse.SUPPRESS)

    worker_p = sub.add_parser("_worker")
    worker_p.add_argument("--voice", required=True)
    worker_p.add_argument("--rate", required=True)
    worker_p.add_argument("--volume", type=int, default=100)
    worker_p.add_argument("--text", required=True)

    args = parser.parse_args()
    cmd = args.cmd or "toggle"

    if cmd == "_daemon":
        run_daemon()
        return

    if cmd == "_worker":
        run_worker(args.text, args.voice, args.rate, args.volume)
        return

    if cmd == "setup":
        setup_environment(show_notifications=False)
        write_state(get_running_pid() is not None)
        print(f"F5-TTS + RVC v2 celebrity models ready in {RVC_DIR} (GPU daemon warm)")
        return

    if cmd == "stop":
        stop_playback(quiet=False)
        return

    if cmd == "pause":
        toggle_pause(force_resume=False)
        return

    if cmd == "resume":
        toggle_pause(force_resume=True)
        return

    if cmd == "format":
        txt = args.text if args.text is not None else get_selected_text()
        print(format_text_for_speech(txt))
        return

    if cmd == "toggle":
        if get_running_pid() is not None:
            stop_playback(quiet=False)
        else:
            cfg = load_config()
            txt = get_selected_text()
            spawn_reader(txt, cfg["voice"], cfg["rate"], cfg.get("volume", 100), show_notification=True)
        return

    if cmd == "read":
        cfg = load_config()
        txt = args.text if args.text is not None else get_selected_text()
        spawn_reader(txt, cfg["voice"], cfg["rate"], cfg.get("volume", 100), show_notification=True)
        return

    if cmd == "preview":
        cfg = load_config()
        voice = args.voice if args.voice in VOICES else cfg["voice"]
        if voice == "morgan_freeman":
            sample = "Hello. I am Morgan Freeman, and I will be narrating your selected text."
        elif voice == "matthew_mcconaughey":
            sample = "Alright, alright, alright. I am Matthew McConaughey, and I will be reading whatever you highlight on your screen."
        elif voice == "shayne_topp":
            sample = "Welcome back to Reddit stories. Today we have a thoughtful confession, and then, OH MY GOSH, the most insane update you have ever heard!"
        elif voice == "shayne_topp_calm":
            sample = "Hello. I am Shayne Topp, reading your selected text with a calm and measured narrative tone."
        elif voice == "shayne_topp_hype":
            sample = "LET'S GO! I am Shayne Topp, ready to bring maximum energy to whatever you highlight on screen!"
        else:
            sample = "Hello there! I am Stephen Fry, ready to read whatever you highlight on your screen."
        spawn_reader(sample, voice, cfg["rate"], cfg.get("volume", 100), show_notification=False)
        return

    if cmd == "set-voice":
        if args.voice not in VOICES:
            print(f"Unknown voice: {args.voice}", file=sys.stderr)
            sys.exit(1)
        cfg = load_config()
        cfg["voice"] = args.voice
        save_config(cfg)
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "set-rate":
        rate_val = args.rate.strip()
        if not rate_val.startswith(("+", "-")):
            rate_val = "+" + rate_val
        if not rate_val.endswith("%"):
            rate_val += "%"
        cfg = load_config()
        cfg["rate"] = rate_val
        save_config(cfg)
        if get_running_pid() is not None:
            _mpv_ipc_command(["set_property", "speed", rate_to_speed(rate_val)])
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "set-volume":
        cfg = load_config()
        cur_vol = int(cfg.get("volume", 100))
        val_str = str(args.volume).strip()
        if val_str.startswith(("+", "-")):
            try:
                delta = int(val_str)
                new_vol = max(0, min(100, cur_vol + delta))
            except ValueError:
                new_vol = cur_vol
        else:
            try:
                new_vol = max(0, min(100, int(val_str)))
            except ValueError:
                new_vol = 100

        cfg["volume"] = new_vol
        save_config(cfg)
        if get_running_pid() is not None:
            _mpv_ipc_command(["set_property", "volume", new_vol])
        st = load_state()
        write_state(get_running_pid() is not None, st.get("textSnippet", ""))
        return

    if cmd == "status":
        alive = get_running_pid() is not None
        st = load_state()
        if st.get("isPlaying") != alive:
            st = write_state(alive)
        print(json.dumps(st, indent=2))
        return


if __name__ == "__main__":
    main()
