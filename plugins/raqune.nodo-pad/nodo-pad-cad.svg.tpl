<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
  <!-- NoDo-pad: Dual Notepad & Task Tracker -->
  <rect x="3.5" y="3.5" width="17" height="17" rx="1.5" fill="none" stroke="{{accent}}" stroke-width="1.2"/>
  <line x1="3.5" y1="8" x2="20.5" y2="8" stroke="{{accent}}" stroke-width="0.9" stroke-dasharray="2,1"/>
  <!-- Tab 1 Notepad indicator (lines) -->
  <line x1="6.5" y1="11.5" x2="12" y2="11.5" stroke="{{muted}}" stroke-width="1.1" stroke-linecap="round"/>
  <line x1="6.5" y1="14.5" x2="11" y2="14.5" stroke="{{muted}}" stroke-width="1.1" stroke-linecap="round"/>
  <line x1="6.5" y1="17.5" x2="10" y2="17.5" stroke="{{muted}}" stroke-width="1.1" stroke-linecap="round"/>
  <!-- Tab 2 Todo checkmark indicator -->
  <rect x="14.5" y="11" width="3" height="3" rx="0.5" fill="none" stroke="{{yellow}}" stroke-width="0.9"/>
  <path d="M 14 15.5 L 15.5 17 L 18.5 13.5" fill="none" stroke="{{green}}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
