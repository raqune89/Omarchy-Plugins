[Unit]
Description=Omarchy Media-Aware Audio Equalizer Daemon
Wants=easyeffects.service
After=graphical-session.target easyeffects.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/raqune/.local/bin/media-equalizer daemon
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=graphical-session.target
